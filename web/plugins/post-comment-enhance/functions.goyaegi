package plugin

import (
	"encoding/json"
	"net/url"
	"strings"

	"hook"
)

const assetVersion = "20260705141547"

var smileyNames = []string{
	"微笑",
	"呲牙",
	"偷笑",
	"调皮",
	"可爱",
	"亲亲",
	"鼓掌",
	"坏笑",
	"得意",
	"大兵",
	"白眼",
	"疑问",
	"惊讶",
	"吓到",
	"流汗",
	"流泪",
	"难过",
	"发怒",
	"发呆",
	"撇嘴",
	"抠鼻",
}

// Register 注册评论表情插件的 hook。
func Register(api *hook.API) {
	// 在 head 中注入 css
	api.AddAction(hook.Consts.ActionHeadEnd, func(api *hook.API, args ...any) {
		renderAssets(api)
	})
	// 评论内容的表情渲染
	api.AddFilter(hook.Consts.FilterCommentContentHTML, func(api *hook.API, value any, args ...any) any {
		return renderSmilies(api, value, args...)
	})
	// 在前台评论框后 插入表情面板
	api.AddAction(hook.Consts.ActionCommentFormAfterTextarea, func(api *hook.API, args ...any) {
		renderSmileyPanel(api, "comment")
	})
	// 后台文章编辑器的表情面板
	api.AddAction(hook.Consts.ActionAdminPostFormAfterTextarea, func(api *hook.API, args ...any) {
		renderSmileyPanel(api, "admin")
	})
	// 文章正文的表情渲染
	api.AddFilter(hook.Consts.FilterPostContentHTML, func(api *hook.API, value any, args ...any) any {
		content := value
		if postSmiliesEnabled(api) {
			content = renderSmilies(api, content, args...)
		}
		return content
	})
	// 文章尾部 HTML（版权声明等）
	api.AddFilter(hook.Consts.FilterPostFooterHTML, func(api *hook.API, value any, args ...any) any {
		return appendPostFooter(api, value, args...)
	})
}

func renderAssets(api *hook.API) {
	if !enabled(api) {
		return
	}
	api.Printf(`<link rel="stylesheet" href="/plugin-assets/post-comment-enhance/style.css?v=%s">`, assetVersion)
}

func enabled(api *hook.API) bool {
	return api.PluginOption("enabled", "true") != "false"
}

func renderSmileyPanel(api *hook.API, mode string) {
	if !enabled(api) {
		return
	}
	if mode == "admin" && api.PluginOption("enable_admin_smiley_panel", "true") == "false" {
		return
	}
	api.Printf(`<div class="smilies" data-smilies data-smilies-mode="%s">`, mode)
	api.Printf(`<div class="smilies-label sr-only">%s</div>`, api.EscapeHTML(api.T("表情")))
	api.Printf(`<div class="smilies-list">`)
	for _, name := range smileyNames {
		code := "[/" + name + "]"
		escapedName := api.EscapeHTML(name)
		escapedCode := api.EscapeHTML(code)
		api.Printf(`<button type="button" class="smiley-btn" data-smiley-code="%s" title="%s" aria-label="%s">`, escapedCode, escapedName, escapedName)
		api.Printf(`<img src="%s" alt="%s" width="24" height="24">`, smileySrc(name), escapedName)
		api.Printf(`</button>`)
	}
	api.Printf(`</div></div>`)
	if mode == "admin" {
		api.Printf(`<script>(function(){var ta=document.getElementById("content_md");if(!ta)return;document.querySelectorAll('[data-smilies-mode="admin"] [data-smiley-code]').forEach(function(b){if(b.dataset.boundSmileyAdmin==="1")return;b.dataset.boundSmileyAdmin="1";b.addEventListener("click",function(){var c=b.getAttribute("data-smiley-code")||"";if(!c)return;var s=ta.selectionStart||0,e=ta.selectionEnd||0;ta.value=ta.value.slice(0,s)+c+ta.value.slice(e);ta.selectionStart=ta.selectionEnd=s+c.length;ta.focus();ta.dispatchEvent(new Event("input",{bubbles:true}))})})})();</script>`)
	}
}

func renderSmilies(api *hook.API, value any, args ...any) any {
	content, ok := value.(string)
	if !ok || content == "" {
		return value
	}
	if !enabled(api) {
		return value
	}
	for _, name := range smileyNames {
		code := "[/" + name + "]"
		img := `<img class="smiley" src="` + smileySrc(name) + `" alt="` + api.EscapeHTML(name) + `" title="` + api.EscapeHTML(name) + `" width="24" height="24">`
		content = strings.ReplaceAll(content, code, img)
	}
	return content
}

// appendPostFooter 在文章正文末尾追加配置的 HTML 尾部内容。
func appendPostFooter(api *hook.API, value any, args ...any) any {
	content, ok := value.(string)
	if !ok || content == "" {
		return value
	}
	footerHTML := api.PluginOption("post_footer_html", "")
	if footerHTML == "" {
		return content
	}
	// 从 args 中提取 post 对象，用其字段替换模板变量
	post := extractPost(args)
	if post != nil {
		footerHTML = replacePostVars(api, footerHTML, post)
	}
	return content + footerHTML
}

// extractPost 从 filter args 中提取 post 对象字段。
// 通过 JSON 序列化/反序列化处理，因为 Yaegi 无法直接访问 *model.Post 类型。
func extractPost(args []any) map[string]any {
	for _, arg := range args {
		if arg == nil {
			continue
		}
		b, err := json.Marshal(arg)
		if err != nil {
			continue
		}
		var m map[string]any
		if err := json.Unmarshal(b, &m); err != nil {
			continue
		}
		return m
	}
	return nil
}

// replacePostVars 替换字符串中的 %var% 变量，风格与固定链接配置一致。
// 可用变量：
//
//	%siteURL% / %siteName% / %siteDesc% — 站点设置
//	%postURL% / %postID% / %postTitle% / %postSlug% / %postExcerpt% — 文章字段
//	%postAuthor% / %postAuthorUsername% — 作者字段
//
// 替换值经过 HTML 转义，防止用户数据注入 XSS。
func replacePostVars(api *hook.API, s string, post map[string]any) string {
	s = replaceVar(s, "%siteURL%", api.EscapeHTML(api.Setting("site_url")))
	s = replaceVar(s, "%siteName%", api.EscapeHTML(api.Setting("site_name")))
	s = replaceVar(s, "%siteDesc%", api.EscapeHTML(api.Setting("site_description")))
	s = replaceVar(s, "%postURL%", api.EscapeHTML(buildPostURL(api, post)))
	s = replaceVar(s, "%postID%", api.EscapeHTML(anyToString(resolveCaseInsensitive(post, []string{"ID"}))))
	s = replaceVar(s, "%postTitle%", api.EscapeHTML(anyToString(resolveCaseInsensitive(post, []string{"Title"}))))
	s = replaceVar(s, "%postSlug%", api.EscapeHTML(anyToString(resolveCaseInsensitive(post, []string{"Slug"}))))
	s = replaceVar(s, "%postExcerpt%", api.EscapeHTML(anyToString(resolveCaseInsensitive(post, []string{"Excerpt"}))))
	s = replaceVar(s, "%postAuthor%", api.EscapeHTML(anyToString(resolveCaseInsensitive(post, []string{"Author", "DisplayName"}))))
	s = replaceVar(s, "%postAuthorUsername%", api.EscapeHTML(anyToString(resolveCaseInsensitive(post, []string{"Author", "Username"}))))
	return s
}

// replaceVar 替换所有出现的 old 为 replacement。
func replaceVar(s, old, replacement string) string {
	return strings.ReplaceAll(s, old, replacement)
}

// resolveCaseInsensitive 在嵌套 map 中按大小写不敏感路径查找值。
func resolveCaseInsensitive(m map[string]any, parts []string) any {
	current := any(m)
	for _, part := range parts {
		cm, ok := current.(map[string]any)
		if !ok {
			return nil
		}
		found := false
		for k, v := range cm {
			if strings.EqualFold(k, part) {
				current = v
				found = true
				break
			}
		}
		if !found {
			return nil
		}
	}
	return current
}

// buildPostURL 根据文章字段构造永久链接。
func buildPostURL(api *hook.API, post map[string]any) string {
	siteURL := strings.TrimRight(api.Setting("site_url"), "/")
	id := anyToString(resolveCaseInsensitive(post, []string{"ID"}))
	postType := anyToString(resolveCaseInsensitive(post, []string{"PostType"}))
	slug := anyToString(resolveCaseInsensitive(post, []string{"Slug"}))
	if postType == "page" && slug != "" {
		return siteURL + "/" + slug
	}
	return siteURL + "/?p=" + id
}

func anyToString(v any) string {
	switch t := v.(type) {
	case string:
		return t
	case bool:
		if t {
			return "true"
		}
		return "false"
	case float64:
		// JSON 数字默认解为 float64，整数直接格式化为不带小数的字符串
		if t == float64(int64(t)) {
			b, _ := json.Marshal(int64(t))
			return string(b)
		}
		b, _ := json.Marshal(t)
		return string(b)
	default:
		return ""
	}
}

func postSmiliesEnabled(api *hook.API) bool {
	return api.PluginOption("enable_post_smilies", "true") != "false"
}

func smileySrc(name string) string {
	return "/plugin-assets/post-comment-enhance/smilies/" + url.PathEscape(name) + ".gif"
}
