package plugin

import "hook"

type SayingItem struct {
	CommentURL  string
	AuthorURL   string
	Snippet     string
	AuthorName  string
	AuthorEmail string
}

// Register 保留插件运行时入口。
// saying 组件由 plugin.yaml 声明，宿主会把启用插件的组件声明加入 widgets.available。
func Register(api *hook.API) {
	api.RegisterFunc("sayingItems", sayingItems)
}

func sayingItems(api *hook.API, args hook.Args) any {
	postID := args.Any("post_id")
	count := args.PositiveInt("count", 5)
	post := api.Post(postID)
	if post == nil {
		return nil
	}
	author := api.User(post.AuthorID)
	if author == nil {
		return nil
	}
	comments := api.CommentsByPost(postID)
	if len(comments) == 0 {
		return nil
	}
	// 只取博主本人的评论，倒序遍历取最新几条。
	items := make([]SayingItem, 0, count)
	for i := len(comments) - 1; i >= 0; i-- {
		c := comments[i]
		if c.UserID == nil || *c.UserID != post.AuthorID {
			continue
		}
		items = append(items, SayingItem{
			CommentURL:  api.CommentURL(post, c),
			AuthorURL:   c.URL,
			Snippet:     api.Snippet(c.Content, 36),
			AuthorName:  author.DisplayName,
			AuthorEmail: author.Email,
		})
		if len(items) >= count {
			break
		}
	}
	return items
}
