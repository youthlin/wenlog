package plugin

import (
	"net/url"
	"strings"

	"hook"
)

const assetVersion = "20260704161000"

var smileyNames = []string{
	"微笑",
	"呲牙",
	"偷笑",
	"调皮",
	"可爱",
	"亲亲",
	"鼓掌",
	"坏笑",
	"得意",
	"大兵",
	"白眼",
	"疑问",
	"惊讶",
	"吓到",
	"流汗",
	"流泪",
	"难过",
	"发怒",
	"发呆",
	"撇嘴",
	"抠鼻",
}

// Register 注册评论表情插件的 hook。
func Register(api *hook.API) {
	api.AddAction(hook.HookHeadEnd, func(api *hook.API, data hook.HeadEndData) {
		renderAssets(api)
	})
	api.AddAction(hook.HookCommentFormAfterTextarea, func(api *hook.API, data hook.CommentFormAfterTextareaData) {
		renderSmileyPanel(api)
	})
	api.AddFilter(hook.HookCommentContentHTML, func(api *hook.API, value any, args ...any) any {
		return renderCommentSmilies(api, value, args...)
	})
}

func renderAssets(api *hook.API) {
	if !enabled(api) {
		return
	}
	api.Printf(`<link rel="stylesheet" href="/plugin-assets/comment-smilies/comment-smilies.css?v=%s">`, assetVersion)
}

func renderSmileyPanel(api *hook.API) {
	if !enabled(api) {
		return
	}
	api.Printf(`<div class="comment-smilies" data-smilies>`)
	api.Printf(`<div class="comment-smilies-label sr-only">%s</div>`, api.EscapeHTML(api.T("表情")))
	api.Printf(`<div class="comment-smilies-list">`)
	for _, name := range smileyNames {
		code := "[/" + name + "]"
		escapedName := api.EscapeHTML(name)
		escapedCode := api.EscapeHTML(code)
		api.Printf(`<button type="button" class="comment-smiley-btn" data-smiley-code="%s" title="%s" aria-label="%s">`, escapedCode, escapedName, escapedName)
		api.Printf(`<img src="%s" alt="%s" width="24" height="24">`, smileySrc(name), escapedName)
		api.Printf(`</button>`)
	}
	api.Printf(`</div></div>`)
}

func renderCommentSmilies(api *hook.API, value any, args ...any) any {
	content, ok := value.(string)
	if !ok || content == "" {
		return value
	}
	if !enabled(api) {
		return value
	}
	for _, name := range smileyNames {
		code := "[/" + name + "]"
		img := `<img class="comment-smiley" src="` + smileySrc(name) + `" alt="` + api.EscapeHTML(name) + `" title="` + api.EscapeHTML(name) + `" width="24" height="24">`
		content = strings.ReplaceAll(content, code, img)
	}
	return content
}

func enabled(api *hook.API) bool {
	return api.PluginOption("enabled", "true") != "false"
}

func smileySrc(name string) string {
	return "/plugin-assets/comment-smilies/smilies/" + url.PathEscape(name) + ".gif"
}
