{{define "admin_revisions.gohtml"}}
{{- template "admin_header" . -}}
<div class="page-head">
  <h1>{{.t.T "修订版本"}}</h1>
  <a class="btn-secondary" href="/admin/post/{{.Post.ID}}">{{.t.T "返回编辑"}}</a>
</div>

<p class="tip">{{.t.T "文章"}}：<strong>{{if .Post.Title}}{{.Post.Title}}{{else}}{{.t.T "（无标题）"}}{{end}}</strong>（ID: {{.Post.ID}}）</p>

{{if .Revisions}}
<div class="table-scroll">
  <table class="data-table revisions-table">
    <thead>
    <tr>
      <th>{{.t.T "版本时间"}}</th>
      <th>{{.t.T "标题"}}</th>
      <th>{{.t.T "操作"}}</th>
    </tr>
    </thead>
    <tbody>
    {{range .Revisions}}
    <tr>
      <td data-label="{{$.t.T "版本时间"}}"><time datetime="{{fmtDateTime .CreatedAt}}">{{fmtDateTime .CreatedAt}}</time></td>
      <td data-label="{{$.t.T "标题"}}">{{if .Title}}{{.Title}}{{else}}{{$.t.T "（无标题）"}}{{end}}</td>
      <td class="actions" data-label="{{$.t.T "操作"}}">
        <a class="btn-secondary btn-sm" href="/admin/post/{{$.Post.ID}}/revision/{{.ID}}">{{$.t.T "查看"}}</a>
        <form class="inline" method="post" action="/admin/post/{{$.Post.ID}}/revision/{{.ID}}/restore" onsubmit="return confirm('{{$.t.T "确定要回滚到此版本吗？当前内容将被覆盖。"}}')">
          {{template "csrf_field" $}}
          <button type="submit" class="btn-warning btn-sm">{{$.t.T "回滚"}}</button>
        </form>
      </td>
    </tr>
    {{end}}
    </tbody>
  </table>
</div>
{{else}}
<p>{{.t.T "暂无修订版本。保存文章后会自动创建。"}}</p>
{{end}}

{{template "admin_footer" .}}
{{end}}
