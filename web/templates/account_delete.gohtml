{{define "account_delete.gohtml"}}
{{template "header" .}}
<h1>{{.t.T "注销账号"}}</h1>
{{if .Error}}<p class="error">{{.Error}}</p>{{end}}
<p class="warning">{{.t.T "注销后你的账号将被永久删除，评论将匿名化保留。此操作不可撤销。"}}</p>
<form method="post" action="/delete-account" class="auth-form">
  <label>{{.t.T "请输入 DELETE 确认"}}<input type="text" name="confirm" required></label>
  <button type="submit" class="link-danger">{{.t.T "确认注销"}}</button>
</form>
<p><a href="/profile">{{.t.T "返回个人资料"}}</a></p>
{{template "footer" .}}
{{end}}
