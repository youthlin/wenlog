{{define "admin_import.gohtml"}}
{{template "admin_header" .}}
<h1>{{.t.T "WXR 导入 / 导出"}}</h1>

{{if .Error}}<p class="err-banner">{{.Error}}</p>{{end}}
{{if .Success}}<p class="notice-banner">{{.Success}}</p>{{end}}

<div class="cards settings-cards">
  <section class="card settings-card">
    <h3>{{.t.T "导入 WordPress XML"}}</h3>
    <p class="tip">{{.t.T "上传 WXR 导出 XML，并选择导入后文章/页面归属到哪个后台用户。"}}</p>
    <p class="warn-banner">{{.t.T "注意：如果数据库中已存在相同 ID 的文章、页面或评论，本次提交会按 upsert 覆盖保存。"}}</p>
    {{if .Users}}
    <form class="edit-form" method="post" action="/admin/import" enctype="multipart/form-data">
      {{template "csrf_field" .}}
      <label>{{.t.T "XML 文件"}}
        <input type="file" name="xml_file" accept=".xml,text/xml,application/xml" required>
      </label>
      <label>{{.t.T "导入归属用户"}}
        <select name="user_id" required>
          <option value="">{{.t.T "请选择用户"}}</option>
          {{range .Users}}
          <option value="{{.ID}}" {{if eq $.SelectedUserID .ID}}selected{{end}}>{{if .DisplayName}}{{.DisplayName}}{{else}}{{.Username}}{{end}}{{if .DisplayName}}（{{.Username}}）{{end}}</option>
          {{end}}
        </select>
      </label>
      <p><button type="submit" class="btn">{{.t.T "开始导入"}}</button></p>
    </form>
    {{else}}
    <p class="err-banner">{{.t.T "当前没有可选用户，请先创建管理员账号。"}}</p>
    {{end}}
  </section>

  <section class="card settings-card">
    <h3>{{.t.T "导入行为"}}</h3>
    <ul class="tip-list">
      <li>{{.t.T "分类、标签会按原始 ID upsert 保存。"}}</li>
      <li>{{.t.T "文章、页面会按原始 WordPress `post_id` upsert 保存。"}}</li>
      <li>{{.t.T "所有导入的文章/页面作者都会改为你在表单中选择的用户。"}}</li>
      <li>{{.t.T "评论会保留原始评论作者信息，并按评论 ID upsert 保存。"}}</li>
      <li>{{.t.T "非 `post` / `page` 类型内容不会导入。"}}</li>
    </ul>
    {{if .ImportStats}}
    <div class="import-result">
      <h4>{{.t.T "最近一次导入结果"}}</h4>
      <p class="tip">{{.t.T "文件：%s" .ImportedFileName}}</p>
      <p class="tip">{{if .TargetUser.DisplayName}}{{.t.T "归属用户：%s" .TargetUser.DisplayName}}{{else}}{{.t.T "归属用户：%s" .TargetUser.Username}}{{end}}</p>
	  <div class="table-scroll table-scroll-compact">
	    <table class="data-table">
	      <tbody>
	        <tr><th>{{.t.T "文章"}}</th><td>{{.ImportStats.Posts}}</td></tr>
	        <tr><th>{{.t.T "页面"}}</th><td>{{.ImportStats.Pages}}</td></tr>
	        <tr><th>{{.t.T "评论"}}</th><td>{{.ImportStats.Comments}}</td></tr>
	        <tr><th>{{.t.T "分类目录"}}</th><td>{{.ImportStats.Categories}}</td></tr>
	        <tr><th>{{.t.T "标签"}}</th><td>{{.ImportStats.Tags}}</td></tr>
	        <tr><th>{{.t.T "设置"}}</th><td>{{.ImportStats.Settings}}</td></tr>
	      </tbody>
	    </table>
	  </div>
    </div>
    {{end}}
  </section>

  <section class="card settings-card">
    <h3>{{.t.T "导出 XML"}}</h3>
    <p class="tip">{{.t.T "导出后可直接在本页重新导入，用于迁移或备份。"}}</p>
    <p class="warn-banner">{{.t.T "说明：若只勾选“评论”而不勾选文章/页面，无法形成可回导 XML，因此提交时会提示错误。"}}</p>
    <form class="edit-form" method="post" action="/admin/export">
      {{template "csrf_field" .}}
      <fieldset class="cat-field">
        <legend>{{.t.T "选择要导出的内容"}}</legend>
        <label class="cat-check"><input type="checkbox" name="include_posts" value="1" {{if .ExportPosts}}checked{{end}}> {{.t.T "文章"}}</label>
        <label class="cat-check"><input type="checkbox" name="include_pages" value="1" {{if .ExportPages}}checked{{end}}> {{.t.T "页面"}}</label>
        <label class="cat-check"><input type="checkbox" name="include_comments" value="1" {{if .ExportComments}}checked{{end}}> {{.t.T "评论"}}</label>
        <label class="cat-check"><input type="checkbox" name="include_settings" value="1" {{if .ExportSettings}}checked{{end}}> {{.t.T "设置"}}</label>
      </fieldset>
      <p><button type="submit" class="btn">{{.t.T "下载 XML"}}</button></p>
    </form>
  </section>
</div>

{{template "admin_footer" .}}
{{end}}
