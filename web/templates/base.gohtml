{{define "header"}}<!DOCTYPE html>
<html lang="{{.htmlLang}}" data-theme="dark"
      data-comment-success="{{.t.T "评论已提交,等待审核后显示。"}}"
      data-comment-fail="{{.t.T "提交失败,请稍后重试。"}}"
      data-comment-network="{{.t.T "网络错误,请稍后重试。"}}"
      data-nav-open-label="{{.t.T "打开菜单"}}"
      data-nav-close-label="{{.t.T "收起菜单"}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
{{if .Description}}<meta name="description" content="{{.Description}}">{{end}}
<link rel="stylesheet" href="/assets/style.css">
<link rel="alternate" type="application/rss+xml" title="{{.SiteName}}" href="/feed">
<script>(function(){try{var themes=['dark','light','red-plum','bamboo','lotus','orange','azure','purple'];var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',themes.indexOf(t)>=0?t:'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();</script>
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="site-title" href="/">{{.SiteName}}</a>
    <nav id="site-nav-menu" class="site-nav" data-nav-panel>
      <div class="site-nav-links">
        {{range .Menu}}<a href="{{pageURL .}}">{{.Title}}</a>{{end}}
      </div>
      <div class="site-nav-utility" aria-label="{{.t.T "界面设置"}}">
        <label class="lang-select-wrap">
          <span class="sr-only">{{.t.T "语言"}}</span>
          <select class="lang-select" aria-label="{{.t.T "语言"}}" onchange="if(this.value)location=this.value">
            <option value="{{index .langURL "zh_CN"}}" {{if eq (.usedLocale) "zh_CN"}}selected{{end}}>中文</option>
            <option value="{{index .langURL "en_US"}}" {{if eq (.usedLocale) "en_US"}}selected{{end}}>English</option>
          </select>
        </label>
        <label class="theme-select-wrap">
          <span class="sr-only">{{.t.T "切换主题"}}</span>
          <select class="theme-select" data-theme-select aria-label="{{.t.T "切换主题"}}">
            <option value="dark">{{.t.T "暗黑"}}</option>
            <option value="light">{{.t.T "明亮"}}</option>
            <option value="red-plum">{{.t.T "红梅"}}</option>
            <option value="bamboo">{{.t.T "绿竹"}}</option>
            <option value="lotus">{{.t.T "藕粉"}}</option>
            <option value="orange">{{.t.T "橙黄"}}</option>
            <option value="azure">{{.t.T "蔚蓝"}}</option>
            <option value="purple">{{.t.T "韵紫"}}</option>
          </select>
        </label>
      </div>
    </nav>
    <div class="header-actions">
      <button type="button" class="nav-toggle" data-nav-toggle aria-label="{{.t.T "打开菜单"}}" aria-controls="site-nav-menu" aria-expanded="false">☰</button>
    </div>
  </div>
</header>
<div class="container layout">
<main class="main-col">
{{end}}

{{define "footer"}}
</main>
{{template "sidebar" .}}
</div>
<div class="scroll-tools">
  <button type="button" class="scroll-btn" data-scroll="top" aria-label="{{.t.T "回顶部"}}">↑</button>
  <button type="button" class="scroll-btn" data-scroll="bottom" aria-label="{{.t.T "到底部"}}">↓</button>
</div>
<footer class="site-footer">
  <div class="container">
    <p>&copy; {{.CurrentYear}} {{.SiteName}} · Powered by Go</p>
  </div>
</footer>
<script src="/assets/theme.js"></script>
<script src="/assets/scroll.js"></script>
</body>
</html>
{{end}}

{{define "pagination"}}
{{with .Pager}}
{{if gt .Pages 1}}
<nav class="pagination">
  {{if gt .Page 1}}<a href="{{.BaseURL}}{{if gt (sub .Page 1) 1}}{{.Sep}}page={{sub .Page 1}}{{end}}">{{$.t.T "上一页"}}</a>{{end}}
  <span class="page-info">{{.Page}} / {{.Pages}}</span>
  {{if lt .Page .Pages}}<a href="{{.BaseURL}}{{.Sep}}page={{add .Page 1}}">{{$.t.T "下一页"}}</a>{{end}}
</nav>
{{end}}
{{end}}
{{end}}

{{define "sidebar"}}
<aside class="sidebar">
  <section class="widget widget-user">
    {{if .CurrentUser}}
    <h3>{{.t.T "%s, 你好" .CurrentUser.DisplayName}}</h3>
    <div class="widget-user-actions">
      <a href="/admin">{{.t.T "控制台"}}</a>
      <form class="inline" method="post" action="/admin/logout" style="display:inline">
        {{template "csrf_field" .}}
        <button type="submit" class="link-btn">{{.t.T "退出"}}</button>
      </form>
    </div>
    {{else}}
    <h3>{{.t.T "欢迎"}}</h3>
    <div class="widget-user-actions">
      <a href="/admin/login">{{.t.T "登录"}}</a>
      {{if .RegistrationOpen}}<a href="/admin/register">{{.t.T "注册"}}</a>{{end}}
    </div>
    {{end}}
  </section>

  <section class="widget widget-search">
    <h3>{{.t.T "搜索"}}</h3>
    <form method="get" action="/search">
      <input type="search" name="q" placeholder="{{.t.T "输入关键词…"}}" value="{{.Keyword}}">
      <button type="submit">{{.t.T "搜索"}}</button>
    </form>
  </section>

  {{if .SayingCommentItems}}
  <section class="widget widget-saying">
    <h3>{{.t.T "博主动态"}}</h3>
    <ul>
      {{range .SayingCommentItems}}
      <li>
        <div class="widget-comment-line"><img class="avatar" src="{{gravatar .Comment.Email}}" alt="" width="24" height="24"><a href="{{.CommentURL}}">{{.Snippet}}</a></div>
        <div class="widget-comment-meta">{{if .AuthorURL}}<a href="{{.AuthorURL}}" target="_blank" rel="nofollow noopener">{{.Comment.Author}}</a>{{else}}{{.Comment.Author}}{{end}} {{$.t.T "发表在"}} <a href="{{.CommentURL}}">{{.Post.Title}}</a></div>
      </li>
      {{end}}
    </ul>
  </section>
  {{end}}

  {{if .RecentPosts}}
  <section class="widget widget-recent-posts">
    <h3>{{.t.T "近期文章"}}</h3>
    <ul>
      {{range .RecentPosts}}<li><a href="{{postURL .}}">{{.Title}}</a></li>{{end}}
    </ul>
  </section>
  {{end}}

  {{if .RecentCommentItems}}
  <section class="widget widget-recent-comments">
    <h3>{{.t.T "近期评论"}}</h3>
    <ul>
      {{range .RecentCommentItems}}
      <li>
        <div class="widget-comment-line"><img class="avatar" src="{{gravatar .Comment.Email}}" alt="" width="24" height="24"><a href="{{.CommentURL}}">{{.Snippet}}</a></div>
        <div class="widget-comment-meta">{{if .AuthorURL}}<a href="{{.AuthorURL}}" target="_blank" rel="nofollow noopener">{{.Comment.Author}}</a>{{else}}{{.Comment.Author}}{{end}} {{$.t.T "发表在"}} <a href="{{.CommentURL}}">{{.Post.Title}}</a></div>
      </li>
      {{end}}
    </ul>
  </section>
  {{end}}

  {{if .ArchiveMonths}}
  <section class="widget widget-archive">
    <h3>{{.t.T "归档"}}</h3>
    <select onchange="if(this.value)location=this.value" data-searchable-select data-searchable-full-width data-search-placeholder="{{.t.T "输入月份筛选…"}}" data-search-empty="{{.t.T "没有匹配的月份"}}">
      <option value="">{{.t.T "选择月份…"}}</option>
      {{range .ArchiveMonths}}<option value="/archive#{{.Year}}">{{$.t.T "%d 年 %d 月(%d)" .Year .Month .Count}}</option>{{end}}
    </select>
  </section>
  {{end}}

  {{if .Categories}}
  <section class="widget widget-categories">
    <h3>{{.t.T "分类目录"}}</h3>
    <select onchange="if(this.value)location=this.value" data-searchable-select data-searchable-full-width data-search-placeholder="{{.t.T "输入分类名筛选…"}}" data-search-empty="{{.t.T "没有匹配的分类"}}">
      <option value="">{{.t.T "选择分类…"}}</option>
      {{range .Categories}}<option value="{{categoryURL .Slug}}">{{.Name}}</option>{{end}}
    </select>
  </section>
  {{end}}

  {{if .Tags}}
  <section class="widget widget-tags">
    <h3>{{.t.T "标签"}}</h3>
    <select onchange="if(this.value)location=this.value" data-searchable-select data-searchable-full-width data-search-placeholder="{{.t.T "输入标签名筛选…"}}" data-search-empty="{{.t.T "没有匹配的标签"}}">
      <option value="">{{.t.T "选择标签…"}}</option>
      {{range .Tags}}<option value="{{tagURL .Slug}}">{{.Name}}</option>{{end}}
    </select>
  </section>
  {{end}}
</aside>
{{end}}
