{{define "header"}}<!DOCTYPE html>
<html lang="zh-Hans" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
{{if .Description}}<meta name="description" content="{{.Description}}">{{end}}
<link rel="stylesheet" href="/assets/style.css">
<link rel="alternate" type="application/rss+xml" title="{{.SiteName}}" href="/feed">
<script>(function(){try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="site-title" href="/">{{.SiteName}}</a>
    <nav class="site-nav" data-nav-panel>
      {{range .Menu}}<a href="{{pageURL .}}">{{.Title}}</a>{{end}}
    </nav>
    <div class="header-actions">
      <button type="button" class="nav-toggle" data-nav-toggle aria-label="打开菜单" aria-expanded="false">☰</button>
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="切换主题">🌓</button>
    </div>
  </div>
</header>
<div class="container layout">
<main class="main-col">
{{end}}

{{define "footer"}}
</main>
{{template "sidebar" .}}
</div>
<div class="scroll-tools">
  <button type="button" class="scroll-btn" data-scroll="top" aria-label="回顶部">↑</button>
  <button type="button" class="scroll-btn" data-scroll="bottom" aria-label="到底部">↓</button>
</div>
<footer class="site-footer">
  <div class="container">
    <p>&copy; {{.CurrentYear}} {{.SiteName}} · Powered by Go</p>
  </div>
</footer>
<script src="/assets/theme.js"></script>
<script src="/assets/scroll.js"></script>
</body>
</html>
{{end}}

{{define "pagination"}}
{{if gt .Pages 1}}
<nav class="pagination">
  {{if gt .Page 1}}<a href="{{.BaseURL}}{{if gt (sub .Page 1) 1}}{{.Sep}}page={{sub .Page 1}}{{end}}">上一页</a>{{end}}
  <span class="page-info">{{.Page}} / {{.Pages}}</span>
  {{if lt .Page .Pages}}<a href="{{.BaseURL}}{{.Sep}}page={{add .Page 1}}">下一页</a>{{end}}
</nav>
{{end}}
{{end}}

{{define "sidebar"}}
<aside class="sidebar">
  <section class="widget widget-search">
    <h3>搜索</h3>
    <form method="get" action="/search">
      <input type="search" name="q" placeholder="输入关键词…" value="{{.Keyword}}">
      <button type="submit">搜索</button>
    </form>
  </section>

  {{if .SayingCommentItems}}
  <section class="widget widget-saying">
    <h3>博主动态</h3>
    <ul>
      {{range .SayingCommentItems}}
      <li>
        <div class="widget-comment-line"><picture class="avatar-picture"><source srcset="{{gravatarPrimary .Comment.Email}}"><img class="avatar" src="{{gravatarFallback .Comment.Email}}" alt="" width="24" height="24"></picture><a href="{{.CommentURL}}">{{.Snippet}}</a></div>
        <div class="widget-comment-meta">{{if .AuthorURL}}<a href="{{.AuthorURL}}" target="_blank" rel="nofollow noopener">{{.Comment.Author}}</a>{{else}}{{.Comment.Author}}{{end}} 发表在 <a href="{{.CommentURL}}">{{.Post.Title}}</a></div>
      </li>
      {{end}}
    </ul>
  </section>
  {{end}}

  {{if .RecentPosts}}
  <section class="widget widget-recent-posts">
    <h3>近期文章</h3>
    <ul>
      {{range .RecentPosts}}<li><a href="{{postURL .}}">{{.Title}}</a></li>{{end}}
    </ul>
  </section>
  {{end}}

  {{if .RecentCommentItems}}
  <section class="widget widget-recent-comments">
    <h3>近期评论</h3>
    <ul>
      {{range .RecentCommentItems}}
      <li>
        <div class="widget-comment-line"><picture class="avatar-picture"><source srcset="{{gravatarPrimary .Comment.Email}}"><img class="avatar" src="{{gravatarFallback .Comment.Email}}" alt="" width="24" height="24"></picture><a href="{{.CommentURL}}">{{.Snippet}}</a></div>
        <div class="widget-comment-meta">{{if .AuthorURL}}<a href="{{.AuthorURL}}" target="_blank" rel="nofollow noopener">{{.Comment.Author}}</a>{{else}}{{.Comment.Author}}{{end}} 发表在 <a href="{{.CommentURL}}">{{.Post.Title}}</a></div>
      </li>
      {{end}}
    </ul>
  </section>
  {{end}}

  {{if .ArchiveMonths}}
  <section class="widget widget-archive">
    <h3>归档</h3>
    <select onchange="if(this.value)location=this.value">
      <option value="">选择月份…</option>
      {{range .ArchiveMonths}}<option value="/archive#{{.Year}}">{{.Year}} 年 {{.Month}} 月({{.Count}})</option>{{end}}
    </select>
  </section>
  {{end}}

  {{if .Categories}}
  <section class="widget widget-categories">
    <h3>分类目录</h3>
    <select onchange="if(this.value)location=this.value">
      <option value="">选择分类…</option>
      {{range .Categories}}<option value="{{categoryURL .Slug}}">{{.Name}}</option>{{end}}
    </select>
  </section>
  {{end}}

  {{if .Tags}}
  <section class="widget widget-tags">
    <h3>标签</h3>
    <select onchange="if(this.value)location=this.value">
      <option value="">选择标签…</option>
      {{range .Tags}}<option value="{{tagURL .Slug}}">{{.Name}}</option>{{end}}
    </select>
  </section>
  {{end}}
</aside>
{{end}}
