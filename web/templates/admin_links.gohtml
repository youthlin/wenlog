{{define "admin_links.gohtml"}}
{{template "admin_header" .}}
<h1>友链管理</h1>
<table class="data-table">
  <thead><tr><th>排序</th><th>名称</th><th>URL</th><th>描述</th><th>操作</th></tr></thead>
  <tbody>
  {{range .Links}}
  <tr>
    <td>{{.Sort}}</td>
    <td>{{.Name}}</td>
    <td><a href="{{.URL}}" target="_blank">{{.URL}}</a></td>
    <td>{{.Description}}</td>
    <td>
      <form class="inline" method="post" action="/admin/link/{{.ID}}/delete" onsubmit="return confirm('确认删除?')">{{template "csrf_field" $}}<button class="link-danger">删除</button></form>
    </td>
  </tr>
  {{else}}
  <tr><td colspan="5">暂无友链</td></tr>
  {{end}}
  </tbody>
</table>

<h2>新增友链</h2>
<form class="edit-form" method="post" action="/admin/link">
  {{template "csrf_field" .}}
  <div class="form-row">
    <label>名称<input type="text" name="name" required></label>
    <label>排序<input type="number" name="sort" value="0"></label>
  </div>
  <label>URL<input type="url" name="url" required></label>
  <label>描述<input type="text" name="description"></label>
  <p><button type="submit" class="btn">添加</button></p>
</form>
{{template "admin_footer" .}}
{{end}}
