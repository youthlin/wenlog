{{define "profile.gohtml"}}
{{template "header" .}}
<h1>{{.t.T "个人资料"}}</h1>
{{if .Error}}<p class="error">{{.Error}}</p>{{end}}
{{$u := .ProfileUser}}
<form method="post" action="/profile" class="profile-form">
  <label>{{.t.T "用户名"}}<input type="text" name="username" value="{{$u.Username}}" required autocomplete="username"></label>
  <label>{{.t.T "显示名"}}<input type="text" name="display_name" value="{{$u.DisplayName}}" autocomplete="name"></label>
  <label>{{.t.T "邮箱"}}<input type="email" name="email" value="{{$u.Email}}" required autocomplete="email"></label>
  <button type="submit">{{.t.T "保存"}}</button>
</form>

<h2>{{.t.T "修改密码"}}</h2>
<form method="post" action="/profile/password" class="profile-form">
  <label>{{.t.T "当前密码"}}<input type="password" name="current_password" required autocomplete="current-password"></label>
  <label>{{.t.T "新密码"}}<input type="password" name="new_password" required autocomplete="new-password"></label>
  <button type="submit">{{.t.T "修改密码"}}</button>
</form>

<div class="profile-links">
  <a href="/my-comments">{{.t.T "我的评论"}}</a>
  <a href="/export-data">{{.t.T "导出个人数据"}}</a>
  <a href="/delete-account" class="link-danger">{{.t.T "注销账号"}}</a>
</div>
{{template "footer" .}}
{{end}}
