{{define "auth_reset_password.gohtml"}}
{{template "header" .}}
<h1>{{.t.T "重置密码"}}</h1>
{{if .Error}}<p class="error">{{.Error}}</p>{{end}}
{{if .Success}}
<p class="notice">{{.Success}}</p>
<p><a href="/login">{{.t.T "前往登录"}}</a></p>
{{else}}
{{if .ResetUser}}
<p class="tip">{{.t.T "正在为 %s 重置密码" .ResetUser.DisplayName}}</p>
{{end}}
<form method="post" action="/reset-password" class="auth-form">
  <input type="hidden" name="token" value="{{.ResetToken}}">
  <label>{{.t.T "新密码"}}<input type="password" name="password" required autocomplete="new-password"></label>
  <label>{{.t.T "确认新密码"}}<input type="password" name="confirm_password" required autocomplete="new-password"></label>
  <button type="submit">{{.t.T "重置密码"}}</button>
</form>
{{end}}
{{template "footer" .}}
{{end}}
