{{define "links.gohtml"}}
{{template "header" .}}
<article class="page-detail">
  <h1 class="post-title">{{.Post.Title}}</h1>
  {{if .Post.Content}}<div class="post-content">{{safeHTML .Post.Content}}</div>{{end}}
  <ul class="link-list">
    {{range .Links}}
    <li><a href="{{.URL}}" target="_blank" rel="noopener">{{.Name}}</a>{{if .Description}} — {{.Description}}{{end}}</li>
    {{else}}
    <li>{{.t.T "暂无友链。"}}</li>
    {{end}}
  </ul>
</article>
{{template "footer" .}}
{{end}}
