{{define "admin_login.gohtml"}}<!DOCTYPE html>
<html lang="{{.htmlLang}}" data-theme="light" data-theme-toggle-label="{{.t.T "切换主题"}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.t.T "登录"}} · {{.SiteName}} {{.t.T "后台"}}</title>
<link rel="stylesheet" href="/assets/admin.css">
<script>(function(){try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
</head>
<body class="admin login-page">
<form class="login-box" method="post" action="/admin/login">
  <div class="login-tools"><button type="button" class="theme-toggle" data-theme-toggle aria-label="{{.t.T "切换主题"}}">🌓</button></div>
  <h1>{{.SiteName}} {{.t.T "后台"}}</h1>
  {{if .Error}}<p class="err">{{.Error}}</p>{{end}}
  {{if .Notice}}<p class="notice">{{.Notice}}</p>{{end}}
  <p><input type="text" name="username" placeholder="{{.t.T "用户名"}}" required autofocus></p>
  <p><input type="password" name="password" placeholder="{{.t.T "密码"}}" required></p>
  <p><button type="submit">{{.t.T "登录"}}</button></p>
  <p id="backtoblog">{{.t.T "← 返回到"}} <a href="/">{{.SiteName}}</a></p>
</form>
<script src="/assets/theme.js"></script>
</body>
</html>
{{end}}
