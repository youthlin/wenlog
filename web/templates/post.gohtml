{{define "post.gohtml"}}
{{template "header" .}}
<article class="post-detail">
  <h1 class="post-title">{{.Post.Title}}{{if .IsDraft}} <span class="draft-badge">{{.t.T "草稿预览"}}</span>{{end}}</h1>
  <div class="post-meta">
    <a class="post-date-link" href="{{postURL .Post}}"><time datetime="{{fmtDateTime .Post.PublishedAt}}">{{fmtDate .Post.PublishedAt}}</time></a>
    {{if .Post.Author.DisplayName}}<span class="author">{{.Post.Author.DisplayName}}</span>{{end}}
    {{range .Post.Categories}}<a class="cat" href="{{categoryURL .Slug}}">{{.Name}}</a>{{end}}
    <span class="views">{{.t.N64 "%d 次阅读" "%d 次阅读" .Post.Views .Post.Views}}</span>
    {{if and .CurrentUserID (eq .CurrentUserID .Post.AuthorID)}}<a class="edit-link" href="/admin/post/{{.Post.ID}}">{{.t.T "编辑"}}</a>{{end}}
  </div>
  <div class="post-content">{{detailHTML .Post}}</div>
  {{if .Post.Tags}}
  <div class="post-tags">
    {{range .Post.Tags}}<a class="tag" href="{{tagURL .Slug}}">#{{.Name}}</a>{{end}}
  </div>
  {{end}}
</article>

<nav class="post-nav">
  <span class="prev">{{if .PrevPost}}<a href="{{postURL .PrevPost}}">← {{.PrevPost.Title}}</a>{{end}}</span>
  <span class="next">{{if .NextPost}}<a href="{{postURL .NextPost}}">{{.NextPost.Title}} →</a>{{end}}</span>
</nav>

{{template "comments" .}}
{{template "footer" .}}
{{end}}

{{define "comments"}}
<section class="comments" id="comments">
  <h3>{{.t.N64 "%d 条评论" "%d 条评论" .CommentCount .CommentCount}}</h3>
  <div id="comments-box">
    {{template "comments_fragment.gohtml" .}}
  </div>
</section>
<script src="/assets/comment.js"></script>
{{end}}

{{define "comments_fragment.gohtml"}}
  <ul class="comment-list">
    {{range .Comments}}
    {{if eq .ParentID 0}}
    <li class="comment{{if eq .Status "pending"}} comment-pending{{end}}" id="comment-{{.ID}}">
      <div class="comment-head">
        <img class="avatar" src="{{avatarURL .Email $.DefaultAvatar}}" alt="" width="40" height="40">
        <a class="comment-id" href="#comment-{{.ID}}">#{{.ID}}</a><span class="comment-author">{{.Author}}</span><time>{{fmtDateTime .CreatedAt}}</time>
        {{if eq .Status "pending"}}<span class="comment-pending-badge">{{$.t.T "评论审核中,当前仅自己可见"}}</span>{{end}}
      </div>
      <div class="comment-body">{{.Content}}</div>
      <button class="comment-reply" type="button" data-reply="{{.ID}}" data-reply-target="comment-{{.ID}}">{{$.t.T "回复"}}</button>
      {{$pid := .ID}}
      <ul class="comment-children">
        {{range $.Comments}}
        {{if eq .ParentID $pid}}
        <li class="comment{{if eq .Status "pending"}} comment-pending{{end}}" id="comment-{{.ID}}">
          <div class="comment-head">
            <img class="avatar" src="{{avatarURL .Email $.DefaultAvatar}}" alt="" width="40" height="40">
            <a class="comment-id" href="#comment-{{.ID}}">#{{.ID}}</a><span class="comment-author">{{.Author}}</span><time>{{fmtDateTime .CreatedAt}}</time>
            {{if eq .Status "pending"}}<span class="comment-pending-badge">{{$.t.T "评论审核中,当前仅自己可见"}}</span>{{end}}
          </div>
          <div class="comment-body">{{if .ReplyToAuthor}}<a class="comment-reply-to" href="#comment-{{.ReplyToID}}">{{$.t.T "回复 @%s" .ReplyToAuthor}}</a>{{end}}{{.Content}}</div>
          <button class="comment-reply" type="button" data-reply="{{.ID}}" data-reply-target="comment-{{.ID}}">{{$.t.T "回复"}}</button>
        </li>
        {{end}}
        {{end}}
      </ul>
    </li>
    {{end}}
    {{end}}
  </ul>

  {{if gt .CommentPager.Pages 1}}
  <nav class="pagination comment-pagination">
    {{if gt .CommentPager.Page 1}}<a href="{{.CommentPager.BaseURL}}?cpage={{sub .CommentPager.Page 1}}#comments" data-cpage="{{sub .CommentPager.Page 1}}">{{.t.T "上一页"}}</a>{{end}}
    <span class="page-info">{{.CommentPager.Page}} / {{.CommentPager.Pages}}</span>
    {{if lt .CommentPager.Page .CommentPager.Pages}}<a href="{{.CommentPager.BaseURL}}?cpage={{add .CommentPager.Page 1}}#comments" data-cpage="{{add .CommentPager.Page 1}}">{{.t.T "下一页"}}</a>{{end}}
  </nav>
  {{end}}

  {{if .CurrentUser}}
  <div class="comment-login-tip">{{if .CurrentUser.DisplayName}}{{safeHTML (.t.T "以 <strong>%s</strong> 的身份发表评论，" (escapeHTML .CurrentUser.DisplayName))}}{{else}}{{safeHTML (.t.T "以 <strong>%s</strong> 的身份发表评论，" (escapeHTML .CurrentUser.Username))}}{{end}}
    <form class="inline" method="post" action="/admin/logout">{{template "csrf_field" .}}<button type="submit">{{.t.T "登出"}}</button></form>
  </div>
  {{end}}

  {{if .CommentOpen}}
  <div id="comment-form-home"></div>
  <form class="comment-form" id="comment-form" method="post" action="/comment">
    <input type="hidden" name="post_id" value="{{.Post.ID}}">
    <input type="hidden" name="parent_id" value="0">
    <input type="hidden" name="reply_to_id" value="0">
    {{if not .CurrentUser}}
      <p><input type="text" name="author" value="{{.RememberedCommenter.Author}}" placeholder="{{.t.T "昵称 *"}}" autocomplete="name" required></p>
      <p><input type="email" name="email" value="{{.RememberedCommenter.Email}}" placeholder="{{.t.T "邮箱 *(不公开)"}}" autocomplete="email" required></p>
      <p><input type="url" name="url" value="{{.RememberedCommenter.URL}}" placeholder="{{.t.T "网站(可选)"}}" autocomplete="url"></p>
    {{end}}
    <p class="hp"><input type="text" name="website" tabindex="-1" autocomplete="off"></p>
    <p><textarea name="content" rows="5" placeholder="{{.t.T "说点什么吧…… *"}}" required></textarea></p>
    {{if .MailEnabled}}<p><label><input type="checkbox" name="notify"> {{.t.T "有回复时邮件通知我"}}</label></p>{{end}}
    <p class="comment-form-actions"><button type="submit">{{.t.T "提交评论"}}</button><button type="button" class="comment-cancel-reply" data-cancel-reply hidden>{{.t.T "取消回复"}}</button></p>
    <p class="comment-tip">{{.t.T "评论提交后需经审核才会显示。"}}</p>
  </form>
  {{else}}
  <p class="comment-closed">{{.t.T "评论已关闭"}}</p>
  {{end}}
{{end}}
