{{- define "admin_comments.gohtml" -}}
{{template "admin_header" .}}
<h1>{{ .Title }}</h1>
{{- if .FilterPostID}}
<p class="filter-info">{{.t.T "文章"}}：<a href="/admin/post/{{.FilterPostID}}">{{.FilterPostTitle}}</a> <a href="/admin/comments?status={{.FilterStatus}}" class="filter-clear">{{.t.T "清除"}}</a></p>
{{- end}}
{{- if not .Mine}}
<nav class="filter-tabs">
  <a href="/admin/comments?status=approved{{if .FilterPostID}}&post_id={{.FilterPostID}}{{end}}" {{if eq .FilterStatus "approved"}}class="active"{{end}}>{{.t.T "已批准"}} ({{.Counts.Approved}})</a>
  <a href="/admin/comments?status=pending{{if .FilterPostID}}&post_id={{.FilterPostID}}{{end}}" {{if eq .FilterStatus "pending"}}class="active"{{end}}>{{.t.T "待审"}} ({{.Counts.Pending}})</a>
  <a href="/admin/comments?status=spam{{if .FilterPostID}}&post_id={{.FilterPostID}}{{end}}" {{if eq .FilterStatus "spam"}}class="active"{{end}}>{{.t.T "垃圾"}} ({{.Counts.Spam}})</a>
</nav>

<form method="post" action="/admin/comments/batch" id="batch-form" class="batch-bar">
  {{template "csrf_field" .}}
  <label class="check-all"><input type="checkbox" id="check-all"> {{.t.T "全选"}}</label>
  {{if ne .FilterStatus "approved"}}<button name="action" value="approve">{{.t.T "批准"}}</button>{{end}}
  {{if ne .FilterStatus "pending"}}<button name="action" value="pending">{{.t.T "待审"}}</button>{{end}}
  {{if ne .FilterStatus "spam"}}<button name="action" value="spam">{{.t.T "垃圾"}}</button>{{end}}
  <button name="action" value="delete" class="link-danger" onclick="return confirm('{{.t.T "确认批量删除选中评论?"}}')">{{.t.T "删除"}}</button>
</form>
{{- end}}

<div class="table-scroll">
  <table class="data-table comments-table">
	    <thead><tr>{{if not .Mine}}<th></th>{{end}}<th>{{.t.T "作者"}}</th><th>{{.t.T "内容"}}</th><th>{{.t.T "操作"}}</th></tr></thead>
	    <tbody>
	    {{range .Comments}}
	    {{$postID := .PostID}}
	    {{$postTitle := index $.CommentPostTitles $postID}}
	    {{$postLink := index $.CommentPostLinks $postID}}
	    <tr class="comments-row">
      {{if not $.Mine}}<td class="comment-check-cell" data-label="{{$.t.T "选择"}}"><input type="checkbox" name="ids" value="{{.ID}}" form="batch-form" class="row-check"></td>{{end}}
	      <td class="editable-cell comment-author-cell" data-label="{{$.t.T "作者"}}">
	        <div class="c-display">
	          <div class="comment-author-panel">
	            <div class="comment-author-head">
	              <img class="avatar comment-author-avatar" src="{{avatarURL .Email $.DefaultAvatar}}" alt="" width="40" height="40">
	              <div class="comment-author-main">
	                <div class="comment-author-line">{{.Author}}</div>
	              </div>
	            </div>
	            <div class="comment-meta-list">
	              <div class="comment-meta"><small>{{$.t.T "邮箱"}}：{{.Email}}</small></div>
	              <div class="comment-meta"><small>{{$.t.T "网址"}}：{{if .URL}}<a href="{{.URL}}" target="_blank" rel="noreferrer">{{.URL}}</a>{{else}}-{{end}}</small></div>
	              <div class="comment-meta"><small>IP：{{.IP}}</small></div>
	            </div>
	          </div>
	        </div>
	        <form class="c-edit" method="post" action="{{if $.Mine}}/admin/my-comments/{{.ID}}/edit{{else}}/admin/comments/edit/{{.ID}}{{end}}" hidden>
	          {{template "csrf_field" $}}
	          <label>{{$.t.T "作者"}}<input type="text" name="author" value="{{.Author}}" required></label>
	          <label>{{$.t.T "邮箱"}}<input type="email" name="email" value="{{.Email}}" required></label>
	          <label>{{$.t.T "网址"}}<input type="url" name="url" value="{{.URL}}" placeholder="https://example.com"></label>
	          <div class="comment-meta"><small>IP：{{.IP}}</small></div>
	          <div class="c-edit-actions">
	            <button type="submit">{{$.t.T "保存"}}</button>
	            <button type="button" class="c-edit-cancel">{{$.t.T "取消"}}</button>
	          </div>
	        </form>
	        <button type="button" class="c-edit-btn">{{$.t.T "编辑"}}</button>
	      </td>
	      <td class="editable-cell comment-cell" data-label="{{$.t.T "内容"}}">
	        <div class="c-display">
	          <time class="comment-date-time" datetime="{{fmtDateTime .CreatedAt}}">{{fmtDateTime .CreatedAt}}</time>
	          <div class="comment-post-line">
	            {{$.t.T "发表在"}}{{if $postLink}}<a href="{{$postLink}}" target="_blank" rel="noreferrer">《{{$postTitle}}》</a>{{else}}《{{$postTitle}}》{{end}}：
	          </div>
	          <div class="comment-body comment-body-clamp" data-comment-body>{{.Content}}</div>
	          <button type="button" class="comment-body-toggle" data-comment-toggle hidden>{{$.t.T "展开"}}</button>
	        </div>
	        <form class="c-edit" method="post" action="{{if $.Mine}}/admin/my-comments/{{.ID}}/edit{{else}}/admin/comments/edit/{{.ID}}{{end}}" hidden>
	          {{template "csrf_field" $}}
	          <textarea name="content" rows="3">{{.Content}}</textarea>
	          <div class="c-edit-actions">
	            <button type="submit">{{$.t.T "保存"}}</button>
	            <button type="button" class="c-edit-cancel">{{$.t.T "取消"}}</button>
	          </div>
	        </form>
	        <button type="button" class="c-edit-btn">{{$.t.T "编辑"}}</button>
	      </td>
	      <td class="actions comment-actions-cell" data-label="{{$.t.T "操作"}}">
	        {{if $.Mine}}
	        <form class="inline" method="post" action="/admin/my-comments/{{.ID}}/delete" onsubmit="return confirm('{{$.t.T "确认删除?"}}')">{{template "csrf_field" $}}<button class="link-danger">{{$.t.T "删除"}}</button></form>
	        {{else}}
	        {{if eq .Status "pending"}}
	          <form class="inline" method="post" action="/admin/comment/{{.ID}}/approve">{{template "csrf_field" $}}<button>{{$.t.T "批准"}}</button></form>
	          <form class="inline" method="post" action="/admin/comment/{{.ID}}/spam">{{template "csrf_field" $}}<button>{{$.t.T "垃圾"}}</button></form>
	        {{else if eq .Status "approved"}}
	          <form class="inline" method="post" action="/admin/comment/{{.ID}}/pending">{{template "csrf_field" $}}<button>{{$.t.T "驳回"}}</button></form>
	          <form class="inline" method="post" action="/admin/comment/{{.ID}}/spam">{{template "csrf_field" $}}<button>{{$.t.T "垃圾"}}</button></form>
	        {{else if eq .Status "spam"}}
	          <form class="inline" method="post" action="/admin/comment/{{.ID}}/pending">{{template "csrf_field" $}}<button>{{$.t.T "待审"}}</button></form>
	          <form class="inline" method="post" action="/admin/comment/{{.ID}}/approve">{{template "csrf_field" $}}<button>{{$.t.T "批准"}}</button></form>
	        {{end}}
	        <form class="inline" method="post" action="/admin/comment/{{.ID}}/delete" onsubmit="return confirm('{{$.t.T "确认删除?"}}')">{{template "csrf_field" $}}<button class="link-danger">{{$.t.T "删除"}}</button></form>
	        {{end}}
	      </td>
	    </tr>
	    {{else}}
	    <tr><td colspan="{{if .Mine}}3{{else}}4{{end}}">{{.t.T "暂无评论"}}</td></tr>
	    {{end}}
	    </tbody>
  </table>
</div>

<p class="total">{{.t.N1_64 "共 %d 条评论" .Total .Total}}</p>
{{- if gt .Pages 1}}
<nav class="pagination">
  {{if .PrevPageURL}}<a href="{{.PrevPageURL}}">{{.t.T "上一页"}}</a>{{end}}
  <span class="page-info">{{.Page}} / {{.Pages}}</span>
  {{if .NextPageURL}}<a href="{{.NextPageURL}}">{{.t.T "下一页"}}</a>{{end}}
</nav>
{{- end}}
<script src="/assets/admin.js?v={{.AssetVersion}}"></script>
{{template "admin_footer" .}}
{{- end}}
