{{define "admin_comments.gohtml"}}
{{template "admin_header" .}}
<h1>评论管理</h1>
<nav class="filter-tabs">
  <a href="/admin/comments?status=pending" {{if eq .FilterStatus "pending"}}class="active"{{end}}>待审 ({{.Counts.Pending}})</a>
  <a href="/admin/comments?status=approved" {{if eq .FilterStatus "approved"}}class="active"{{end}}>已批准 ({{.Counts.Approved}})</a>
  <a href="/admin/comments?status=spam" {{if eq .FilterStatus "spam"}}class="active"{{end}}>垃圾 ({{.Counts.Spam}})</a>
</nav>

<form method="post" action="/admin/comments/batch" id="batch-form" class="batch-bar">
  {{template "csrf_field" .}}
  批量:
  {{if ne .FilterStatus "approved"}}<button name="action" value="approve">批准</button>{{end}}
  {{if ne .FilterStatus "pending"}}<button name="action" value="pending">待审</button>{{end}}
  {{if ne .FilterStatus "spam"}}<button name="action" value="spam">垃圾</button>{{end}}
  <button name="action" value="delete" class="link-danger" onclick="return confirm('确认批量删除选中评论?')">删除</button>
  <label class="check-all"><input type="checkbox" id="check-all"> 全选</label>
</form>

<table class="data-table comments-table">
  <thead><tr><th></th><th>作者</th><th>内容</th><th>文章</th><th>时间</th><th>操作</th></tr></thead>
  <tbody>
  {{range .Comments}}
  <tr>
    <td><input type="checkbox" name="ids" value="{{.ID}}" form="batch-form" class="row-check"></td>
    <td>{{.Author}}<br><small>{{.Email}}</small></td>
    <td class="comment-cell">
      <div class="c-text">{{.Content}}</div>
      <form class="c-edit" method="post" action="/admin/comments/edit/{{.ID}}" hidden>
        {{template "csrf_field" $}}
        <textarea name="content" rows="3">{{.Content}}</textarea>
        <button type="submit">保存</button>
        <button type="button" class="c-edit-cancel">取消</button>
      </form>
      <button type="button" class="c-edit-btn">编辑</button>
    </td>
    <td><a href="/?p={{.PostID}}" target="_blank">#{{.PostID}}</a></td>
    <td>{{fmtDateTime .CreatedAt}}</td>
    <td class="actions">
      {{if eq .Status "pending"}}
        <form class="inline" method="post" action="/admin/comment/{{.ID}}/approve">{{template "csrf_field" $}}<button>批准</button></form>
        <form class="inline" method="post" action="/admin/comment/{{.ID}}/spam">{{template "csrf_field" $}}<button>垃圾</button></form>
      {{else if eq .Status "approved"}}
        <form class="inline" method="post" action="/admin/comment/{{.ID}}/pending">{{template "csrf_field" $}}<button>驳回</button></form>
        <form class="inline" method="post" action="/admin/comment/{{.ID}}/spam">{{template "csrf_field" $}}<button>垃圾</button></form>
      {{else if eq .Status "spam"}}
        <form class="inline" method="post" action="/admin/comment/{{.ID}}/pending">{{template "csrf_field" $}}<button>待审</button></form>
        <form class="inline" method="post" action="/admin/comment/{{.ID}}/approve">{{template "csrf_field" $}}<button>批准</button></form>
      {{end}}
      <form class="inline" method="post" action="/admin/comment/{{.ID}}/delete" onsubmit="return confirm('确认删除?')">{{template "csrf_field" $}}<button class="link-danger">删除</button></form>
    </td>
  </tr>
  {{else}}
  <tr><td colspan="6">暂无评论</td></tr>
  {{end}}
  </tbody>
</table>

<p class="total">共 {{.Total}} 条</p>
{{if gt .Pages 1}}
<nav class="pagination">
  {{if gt .Page 1}}<a href="/admin/comments?status={{.FilterStatus}}&page={{sub .Page 1}}">上一页</a>{{end}}
  <span class="page-info">{{.Page}} / {{.Pages}}</span>
  {{if lt .Page .Pages}}<a href="/admin/comments?status={{.FilterStatus}}&page={{add .Page 1}}">下一页</a>{{end}}
</nav>
{{end}}
<script src="/assets/admin.js"></script>
{{template "admin_footer" .}}
{{end}}
