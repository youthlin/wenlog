{{define "auth_login.gohtml"}}
{{template "header" .}}
<h1>{{.t.T "登录"}}</h1>
{{if .Error}}<p class="error">{{.Error}}</p>{{end}}
<form method="post" action="/login" class="auth-form">
  <label>{{.t.T "用户名"}}<input type="text" name="username" required autocomplete="username"></label>
  <label>{{.t.T "密码"}}<input type="password" name="password" required autocomplete="current-password"></label>
  <button type="submit">{{.t.T "登录"}}</button>
</form>
<p class="auth-alt">{{.t.T "没有账号？"}} <a href="/register">{{.t.T "注册"}}</a></p>
{{template "footer" .}}
{{end}}
