{{define "admin_error.gohtml"}}<!DOCTYPE html>
<html lang="{{.htmlLang}}">
<head>
<meta charset="utf-8">
<title>{{.Title}}</title>
<link rel="stylesheet" href="/assets/admin.css?v={{.AssetVersion}}">
</head>
<body class="admin"><main class="admin-main">
<h1>{{.Title}}</h1>
<p>{{.Message}}</p>
<p><a href="/admin/">{{.t.T "返回后台"}}</a></p>
</main>
</body>
</html>
{{- end}}
