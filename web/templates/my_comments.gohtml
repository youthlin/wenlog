{{define "my_comments.gohtml"}}
{{template "header" .}}
<h1>{{.t.T "我的评论"}}</h1>
<p class="total">{{.t.N64 "共 %d 条评论" "共 %d 条评论" .Total .Total}}</p>
{{if .Comments}}
<div class="table-scroll">
  <table class="data-table">
    <thead><tr><th>{{.t.T "内容"}}</th><th>{{.t.T "文章"}}</th><th>{{.t.T "时间"}}</th><th>{{.t.T "操作"}}</th></tr></thead>
    <tbody>
    {{range .Comments}}
    {{$postTitle := index $.PostTitles .PostID}}
    {{$postLink := index $.PostLinks .PostID}}
    <tr>
      <td>{{.Content}}</td>
      <td>{{if $postLink}}<a href="{{$postLink}}">{{$postTitle}}</a>{{else}}{{$postTitle}}{{end}}</td>
      <td><time datetime="{{fmtDateTime .CreatedAt}}">{{fmtDate .CreatedAt}}</time></td>
      <td>
        <form class="inline" method="post" action="/my-comments/{{.ID}}/delete" onsubmit="return confirm('{{$.t.T "确认删除?"}}')">
          <button type="submit" class="link-danger">{{$.t.T "删除"}}</button>
        </form>
      </td>
    </tr>
    {{end}}
    </tbody>
  </table>
</div>
{{if gt .Pages 1}}
<nav class="pagination">
  {{if gt .Page 1}}<a href="/my-comments?page={{sub .Page 1}}">{{.t.T "上一页"}}</a>{{end}}
  <span class="page-info">{{.Page}} / {{.Pages}}</span>
  {{if lt .Page .Pages}}<a href="/my-comments?page={{add .Page 1}}">{{.t.T "下一页"}}</a>{{end}}
</nav>
{{end}}
{{else}}
<p>{{.t.T "暂无评论"}}</p>
{{end}}
{{template "footer" .}}
{{end}}
