{{- define "admin_post_edit.gohtml" -}}
{{template "admin_header" .}}
<h1>{{if .IsEdit}}{{if eq .PostType "page"}}{{.t.T "编辑%s" (.t.X "admin.post_type.singular" "页面")}}{{else}}{{.t.T "编辑%s" (.t.X "admin.post_type.singular" "文章")}}{{end}}{{else}}{{if eq .PostType "page"}}{{.t.T "新建%s" (.t.X "admin.post_type.singular" "页面")}}{{else}}{{.t.T "新建%s" (.t.X "admin.post_type.singular" "文章")}}{{end}}{{end}}</h1>
{{- if .Error}}
<p class="err-banner">{{.Error}}</p>
{{- end}}
<form class="edit-form" method="post" action="/admin/post">
  {{template "csrf_field" .}}
  {{if .Post}}<input type="hidden" name="id" value="{{.Post.ID}}">{{end}}
  <input type="hidden" name="post_type" value="{{.PostType}}">
  <label>{{.t.T "标题"}}<input type="text" name="title" value="{{if .Post}}{{.Post.Title}}{{end}}" required data-slug-source></label>
  {{if eq .PostType "page"}}
  <label>{{.t.T "Slug(页面链接 /slug)"}}<input type="text" name="slug" value="{{if .Post}}{{.Post.Slug}}{{end}}" required data-slug-target data-slug-mode="page"></label>
  <label>{{.t.T "导航顺序(0 = 不在顶部导航显示,大于 0 为排序)"}}<input type="number" name="menu_order" value="{{if .Post}}{{.Post.MenuOrder}}{{end}}"></label>
  <p class="form-hint">{{.t.T "建议顺序值间隔大一些（如 10、20、30），方便之后在页面之间插入新页面。"}}</p>
  {{else}}
  <label>{{.t.T "Slug(文章别名，可选)"}}<input type="text" name="slug" value="{{if .Post}}{{.Post.Slug}}{{end}}" placeholder="hello-world" data-slug-target data-slug-mode="post"></label>
  <p class="form-hint">{{.t.T "可留空自动根据标题生成；当文章固定链接结构包含 %postname% 时，这个 slug 会出现在文章链接中。"}}</p>
  {{end}}

  <label>{{.t.T "正文(Markdown)"}}</label>
  <div class="markdown-toolbar" aria-label="{{.t.T "Markdown 工具栏"}}">
    <button type="button" class="btn-secondary" data-md-action="heading">H2</button>
    <button type="button" class="btn-secondary" data-md-action="bold"><strong>B</strong></button>
    <button type="button" class="btn-secondary" data-md-action="italic"><em>I</em></button>
    <button type="button" class="btn-secondary" data-md-action="quote">{{.t.T "引用"}}</button>
    <button type="button" class="btn-secondary" data-md-action="ul">{{.t.T "列表"}}</button>
    <button type="button" class="btn-secondary" data-md-action="ol">1.</button>
    <button type="button" class="btn-secondary" data-md-action="code">{{.t.T "代码"}}</button>
    <button type="button" class="btn-secondary" data-md-action="codeblock">{{.t.T "代码块"}}</button>
    <button type="button" class="btn-secondary" data-md-action="link">{{.t.T "链接"}}</button>
    <button type="button" class="btn-secondary" data-md-action="more">more</button>
    <button type="button" class="btn-secondary" data-md-action="hr">---</button>
    <label class="btn-secondary upload-btn">{{.t.T "上传图片"}}<input type="file" id="upload_file" accept="image/png,image/jpeg,image/gif,image/webp" hidden></label>
    <button type="button" class="btn-secondary" id="pick_upload_btn">{{.t.T "选择已上传图片"}}</button>
    <span class="tip" id="upload_status"></span>
  </div>
  <p class="tip toolbar-tip">{{.t.T "支持文件上传、直接粘贴剪贴板图片，或从文件库选择后自动插入 Markdown。"}}</p>
  <div class="upload-picker" id="upload_picker" hidden>
    <div class="upload-picker-head">
      <strong>{{.t.T "选择已上传图片"}}</strong>
      <button type="button" class="btn-secondary" id="close_upload_picker">{{.t.T "关闭"}}</button>
    </div>
    <div class="upload-picker-list" id="upload_picker_list"></div>
  </div>
  <div class="draft-restore" id="draft_restore" hidden>
    <span>{{.t.T "检测到本地自动保存的草稿。"}}</span>
    <button type="button" class="btn-secondary" id="restore_draft_btn">{{.t.T "恢复草稿"}}</button>
    <button type="button" class="btn-secondary" id="discard_draft_btn">{{.t.T "忽略"}}</button>
  </div>
  <div class="md-view-tabs" aria-label="{{.t.T "编辑器视图"}}">
    <button type="button" class="btn-secondary active" data-md-view="edit">{{.t.T "编辑"}}</button>
    <button type="button" class="btn-secondary" data-md-view="split">{{.t.T "分栏预览"}}</button>
    <button type="button" class="btn-secondary" data-md-view="preview">{{.t.T "预览"}}</button>
  </div>
  <div class="md-editor is-edit" data-md-editor>
    <textarea name="content_md" id="content_md" rows="20" required>{{if .Post}}{{.Post.ContentMD}}{{end}}</textarea>
    <div class="md-preview" id="md_preview"></div>
  </div>
  {{- slot "admin.post.form.after_textarea" $ -}}
  <p><span class="tip" id="draft_status">{{.t.T "支持 Markdown(兼容 HTML);<!--more--> 标记列表页截断。"}}</span></p>

  <label>{{.t.T "摘要(可选)"}}<textarea name="excerpt" rows="3">{{if .Post}}{{.Post.Excerpt}}{{end}}</textarea></label>

  {{if eq .PostType "post"}}
  <fieldset class="cat-field" data-category-required data-category-required-message="{{.t.T "请至少选择一个分类目录。"}}">
    <legend>{{.t.T "分类目录"}}</legend>
    {{range .AllCategories}}
    <label class="cat-check"><input type="checkbox" name="category_ids" value="{{.ID}}" {{if index $.SelectedCats .ID}}checked{{end}}> {{.Name}}</label>
    {{else}}
    <p class="tip">{{.t.T "还没有分类目录，可先去 分类/标签管理 新建分类。"}}</p>
    {{end}}
  </fieldset>
  <label>{{.t.T "标签(逗号分隔)"}}<input type="text" name="tags" value="{{.TagsCSV}}" placeholder="{{.t.T "如:Go, 教程, 随笔"}}"></label>
  {{end}}

  <div class="form-row">
    <label>{{.t.T "状态"}}
      <select name="status">
        <option value="published" {{if and .Post (eq .Post.Status "published")}}selected{{end}}>{{.t.T "发布"}}</option>
        <option value="draft" {{if and .Post (eq .Post.Status "draft")}}selected{{end}}>{{.t.T "草稿"}}</option>
        <option value="scheduled" {{if and .Post (eq .Post.Status "scheduled")}}selected{{end}}>{{.t.T "定时发布"}}</option>
      </select>
    </label>
    <label>{{.t.T "发布时间"}}<input type="datetime-local" name="published_at" value="{{if .Post}}{{if not .Post.PublishedAt.IsZero}}{{fmtDateTimeLocal .Post.PublishedAt}}{{end}}{{end}}"></label>
    <label>{{.t.T "评论"}}
      <select name="comment_status">
        <option value="open" {{if and .Post (ne .Post.CommentStatus "closed")}}selected{{end}}>{{.t.T "开放"}}</option>
        <option value="closed" {{if and .Post (eq .Post.CommentStatus "closed")}}selected{{end}}>{{.t.X "admin.comment_status.option" "关闭"}}</option>
      </select>
    </label>
  </div>
  <p><button type="submit" class="btn">{{.t.T "保存"}}</button> <a href="/admin/posts?type={{.PostType}}">{{.t.T "取消"}}</a>{{if .IsEdit}} <a class="btn-secondary" href="/admin/post/{{.Post.ID}}/revisions">{{.t.T "修订版本"}}</a>{{end}}</p>
</form>
<script src="/assets/admin.js?v={{.AssetVersion}}"></script>
{{template "admin_footer" .}}
{{- end}}
