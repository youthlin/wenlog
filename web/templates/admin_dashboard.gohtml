{{define "admin_dashboard.gohtml"}}
{{template "admin_header" .}}
<h1>欢迎回来</h1>
<div class="cards">
  <a class="card" href="/admin/posts?type=post"><h3>文章</h3><p>管理博客文章</p></a>
  <a class="card" href="/admin/posts?type=page"><h3>页面</h3><p>管理独立页面</p></a>
  <a class="card" href="/admin/comments"><h3>评论</h3><p>{{.PendingCount}} 条待审</p></a>
  <a class="card" href="/admin/links"><h3>友链</h3><p>管理友情链接</p></a>
  <a class="card" href="/admin/import"><h3>导入</h3><p>上传 WordPress XML 并覆盖导入</p></a>
</div>
{{template "admin_footer" .}}
{{end}}
