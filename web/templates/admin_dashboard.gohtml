{{define "admin_dashboard.gohtml"}}
{{- template "admin_header" . -}}
<h1>{{.t.T "欢迎回来"}}</h1>

{{- $stats := .Stats -}}
<div class="dashboard-stats">
  <a class="stat-card" href="/admin/posts?type=post">
    <span class="stat-icon">📝</span>
    <span class="stat-value">{{$stats.PostsPublished}}</span>
    <span class="stat-label">{{.t.T "已发布文章"}}</span>
    {{- if gt $stats.PostsDraft 0}}
    <span class="stat-sub">{{.t.N64 "%d 篇草稿" "%d 篇草稿" $stats.PostsDraft $stats.PostsDraft}}</span>
    {{- end}}
  </a>
  <a class="stat-card" href="/admin/posts?type=page">
    <span class="stat-icon">📄</span>
    <span class="stat-value">{{$stats.PagesPublished}}</span>
    <span class="stat-label">{{.t.T "已发布页面"}}</span>
    {{- if gt $stats.PagesDraft 0}}
    <span class="stat-sub">{{.t.N64 "%d 篇草稿" "%d 篇草稿" $stats.PagesDraft $stats.PagesDraft}}</span>
    {{- end}}
  </a>
  <a class="stat-card" href="/admin/comments">
    <span class="stat-icon">💬</span>
    <span class="stat-value">{{$stats.Comments.Approved}}</span>
    <span class="stat-label">{{.t.T "已批准评论"}}</span>
    {{- if gt $stats.Comments.Pending 0}}
    <span class="stat-sub stat-warn">{{.t.N64 "%d 条待审" "%d 条待审" $stats.Comments.Pending $stats.Comments.Pending}}</span>
    {{- end}}
  </a>
  <a class="stat-card" href="/admin/categories">
    <span class="stat-icon">📁</span>
    <span class="stat-value">{{$stats.CategoryCount}}</span>
    <span class="stat-label">{{.t.T "分类"}}</span>
  </a>
  <a class="stat-card" href="/admin/tags">
    <span class="stat-icon">🏷️</span>
    <span class="stat-value">{{$stats.TagCount}}</span>
    <span class="stat-label">{{.t.T "标签"}}</span>
  </a>
  <a class="stat-card" href="/admin/uploads">
    <span class="stat-icon">🖼️</span>
    <span class="stat-value">{{$stats.UploadCount}}</span>
    <span class="stat-label">{{.t.T "附件"}}</span>
  </a>
</div>

<div class="dashboard-actions">
  <a class="btn" href="/admin/post/new?type=post">{{.t.T "写文章"}}</a>
  <a class="btn" href="/admin/post/new?type=page">{{.t.T "新建页面"}}</a>
  {{- if gt $stats.Comments.Pending 0}}
  <a class="btn btn-accent" href="/admin/comments?status=pending">{{.t.T "审核评论"}}</a>
  {{- end}}
  <a class="btn" href="/admin/uploads">{{.t.T "附件"}}</a>
</div>

<div class="dashboard-grid">
  <div class="dashboard-panel">
    <h2 class="panel-title">{{.t.T "最近文章"}}</h2>
    {{- if .RecentPosts}}
    <ul class="dashboard-list">
      {{- range .RecentPosts}}
      <li>
        <a class="dashboard-list-link" href="/admin/post/{{.ID}}">{{.Title}}</a>
        <time class="dashboard-list-meta">{{fmtDate .PublishedAt}}</time>
      </li>
      {{- end}}
    </ul>
    {{- else}}
    <p class="dashboard-empty">{{.t.T "暂无文章"}}</p>
    {{- end}}
  </div>
  <div class="dashboard-panel">
    <h2 class="panel-title">{{.t.T "最近评论"}}</h2>
    {{- if .RecentComments}}
    <ul class="dashboard-list">
      {{- range .RecentComments}}
      <li>
        <a class="dashboard-list-link" href="/admin/comments?status=approved">{{.Author}}</a>
        <span class="dashboard-list-on">{{$.t.T "在"}}</span>
        {{- $postTitle := index $.CommentPostTitles .PostID}}
        <span class="dashboard-list-post">{{if $postTitle}}{{$postTitle}}{{else}}#{{.PostID}}{{end}}</span>
        <time class="dashboard-list-meta">{{fmtDate .CreatedAt}}</time>
      </li>
      {{- end}}
    </ul>
    {{- else}}
    <p class="dashboard-empty">{{.t.T "暂无评论"}}</p>
    {{- end}}
  </div>
</div>
{{- template "admin_footer" . -}}
{{end}}
