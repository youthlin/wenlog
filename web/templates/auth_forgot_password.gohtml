{{define "auth_forgot_password.gohtml"}}
{{template "header" .}}
<h1>{{.t.T "忘记密码"}}</h1>
{{if .Error}}<p class="error">{{.Error}}</p>{{end}}
{{if .Success}}<p class="notice">{{.Success}}</p>{{end}}
<form method="post" action="/forgot-password" class="auth-form">
  <p class="tip">{{.t.T "请输入注册时使用的邮箱地址，我们将发送密码重置链接。"}}</p>
  <label>{{.t.T "邮箱"}}<input type="email" name="email" required autocomplete="email"></label>
  <button type="submit">{{.t.T "发送重置链接"}}</button>
</form>
<p class="auth-alt"><a href="/login">{{.t.T "返回登录"}}</a></p>
{{template "footer" .}}
{{end}}
