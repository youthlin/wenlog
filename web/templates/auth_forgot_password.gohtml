{{define "auth_forgot_password.gohtml"}}<!DOCTYPE html>
<html lang="{{.htmlLang}}" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.SiteName}} · {{.t.T "忘记密码"}}</title>
<link rel="stylesheet" href="/assets/admin.css?v={{.AssetVersion}}">
<script>(function(){try{var themes=['dark','light','red-plum','bamboo','lotus','orange','azure','purple'];var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',themes.indexOf(t)>=0?t:'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();</script>
</head>
<body class="admin login-page">
<form class="login-box" method="post" action="/auth/forgot-password">
  <div class="login-tools">
    <label class="lang-select-wrap">
      <span class="sr-only">{{.t.T "语言"}}</span>
      <select class="lang-select" aria-label="{{.t.T "语言"}}" onchange="if(this.value)location=this.value">
        <option value="{{index .langURL "zh_CN"}}" {{if eq (.usedLocale) "zh_CN"}}selected{{end}}>{{.t.T "中文"}}</option>
        <option value="{{index .langURL "en_US"}}" {{if eq (.usedLocale) "en_US"}}selected{{end}}>{{.t.T "English"}}</option>
      </select>
    </label>
    <label class="theme-select-wrap">
      <span class="sr-only">{{.t.T "切换主题"}}</span>
      <select class="theme-select" data-theme-select aria-label="{{.t.T "切换主题"}}">
        <option value="dark">{{.t.T "暗黑"}}</option>
        <option value="light">{{.t.T "明亮"}}</option>
        <option value="red-plum">{{.t.T "红梅"}}</option>
        <option value="bamboo">{{.t.T "绿竹"}}</option>
        <option value="lotus">{{.t.T "藕粉"}}</option>
        <option value="orange">{{.t.T "橙黄"}}</option>
        <option value="azure">{{.t.T "蔚蓝"}}</option>
        <option value="purple">{{.t.T "韵紫"}}</option>
      </select>
    </label>
  </div>
  <h1>{{.SiteName}} · {{.t.T "忘记密码"}}</h1>
  {{if .Error}}<p class="err">{{.Error}}</p>{{end}}
  {{if .Success}}<p class="notice">{{.Success}}</p>{{end}}
  <p class="auth-tip">{{.t.T "请输入注册时使用的邮箱地址，我们将发送密码重置链接。"}}</p>
  <p><label class="sr-only" for="forgot-email">{{.t.T "邮箱"}}</label><input id="forgot-email" type="email" name="email" placeholder="{{.t.T "邮箱"}}" required autocomplete="email" autofocus></p>
  <p><button type="submit">{{.t.T "发送重置链接"}}</button></p>
  <p class="auth-alt"><a href="/auth/login">{{.t.T "返回登录"}}</a></p>
  <p id="backtowenlog">{{.t.T "← 返回到"}} <a href="/">{{.SiteName}}</a></p>
</form>
<script src="/assets/theme.js?v={{.AssetVersion}}"></script>
</body>
</html>
{{- end}}
