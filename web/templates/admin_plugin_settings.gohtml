{{- define "admin_plugin_settings.gohtml" -}}
{{template "admin_header" .}}
<div class="page-head">
  <h1>{{.t.T "插件设置"}} — {{.PluginName}}</h1>
</div>

{{- if .Notice}}
<p class="notice-banner">{{.Notice}}</p>
{{- end}}
{{- if .Error}}
<p class="err-banner">{{.Error}}</p>
{{- end}}

{{- if .Plugin}}
<p class="tip"><a href="/admin/plugins">← {{.t.T "返回插件列表"}}</a></p>
{{- if .NoOptions}}
<p class="tip">{{.t.T "当前插件未声明任何可配置选项。"}}</p>
{{- else}}
<form method="post" action="/admin/plugin/{{.PluginID}}/settings" class="theme-options-form">
  {{template "csrf_field" .}}
  {{range .Options}}
  {{$opt := .}}
  <section class="card settings-card">
    <label for="option_{{$opt.ID}}"><strong>{{$.tp.T $opt.Label}}</strong></label>
    {{if $opt.Description}}<p class="tip">{{$.tp.T $opt.Description}}</p>{{end}}

    {{if eq $opt.Type "text"}}
    <input type="text" id="option_{{$opt.ID}}" name="option_{{$opt.ID}}" value="{{$opt.Value}}">

    {{else if eq $opt.Type "textarea"}}
    <textarea id="option_{{$opt.ID}}" name="option_{{$opt.ID}}" rows="4">{{$opt.Value}}</textarea>

    {{else if eq $opt.Type "number"}}
    <input type="number" id="option_{{$opt.ID}}" name="option_{{$opt.ID}}" value="{{$opt.Value}}"
      {{if $opt.Min}}min="{{$opt.Min}}"{{end}} {{if $opt.Max}}max="{{$opt.Max}}"{{end}}>

    {{else if eq $opt.Type "select"}}
    <select id="option_{{$opt.ID}}" name="option_{{$opt.ID}}">
      {{range $opt.Options}}
      <option value="{{.Value}}" {{if eq .Value $opt.Value}}selected{{end}}>{{$.tp.T .Label}}</option>
      {{end}}
    </select>

    {{else if eq $opt.Type "bool"}}
    <label class="checkbox-label">
      <input type="checkbox" id="option_{{$opt.ID}}" name="option_{{$opt.ID}}" value="true" {{if eq $opt.Value "true"}}checked{{end}}>
      <span>{{$.t.T "启用"}}</span>
    </label>

    {{else if eq $opt.Type "shortcode_rules"}}
    <div class="shortcode-rules" data-shortcode-rules>
      <textarea id="option_{{$opt.ID}}" name="option_{{$opt.ID}}" hidden>{{$opt.Value}}</textarea>
      <div class="shortcode-rules-list" data-shortcode-rules-list></div>
      <button type="button" class="btn-secondary btn-sm" data-shortcode-add>{{$.t.T "添加短代码"}}</button>
      <template data-shortcode-rule-template>
        <div class="shortcode-rule" data-shortcode-rule>
          <div class="shortcode-rule-grid">
            <label>
              <span>{{$.t.T "短代码名称"}}</span>
              <input type="text" data-shortcode-name maxlength="32" placeholder="cube">
            </label>
            <label>
              <span>{{$.t.T "渲染为"}}</span>
              <select data-shortcode-tag>
                <option value="iframe">iframe</option>
                <option value="a">a</option>
                <option value="div">div</option>
                <option value="span">span</option>
              </select>
            </label>
            <button type="button" class="btn-secondary btn-sm link-danger shortcode-remove-rule" data-shortcode-remove>{{$.t.T "删除"}}</button>
          </div>
          <div class="shortcode-attrs" data-shortcode-attrs></div>
          <div class="shortcode-add-attr">
            <select data-shortcode-attr-select>
              {{range $opt.Options}}
              <option value="{{.Value}}">{{$.tp.T .Label}}</option>
              {{end}}
            </select>
            <button type="button" class="btn-secondary btn-sm" data-shortcode-attr-add>{{$.t.T "添加允许属性"}}</button>
          </div>
        </div>
      </template>
      <template data-shortcode-attr-template>
        <div class="shortcode-attr" data-shortcode-attr>
          <label>
            <span>{{$.t.T "属性名"}}</span>
            <select data-shortcode-attr-name>
              {{range $opt.Options}}
              <option value="{{.Value}}">{{$.tp.T .Label}}</option>
              {{end}}
            </select>
          </label>
          <label>
            <span>{{$.t.T "属性值正则"}}</span>
            <input type="text" data-shortcode-attr-pattern placeholder="^https://host\.com(?:/|$)">
          </label>
          <button type="button" class="btn-secondary btn-sm link-danger shortcode-remove-attr" data-shortcode-attr-remove>{{$.t.T "删除"}}</button>
        </div>
      </template>
      <p class="form-hint">{{$.t.T "建议使用 ^ 和 $ 或明确的路径边界。例如 ^https://host\\.com(?:/|$)；仅配置 ^https://host\\.com 也会匹配 https://host.com.evil.com。"}}</p>
    </div>

    {{else}}
    <input type="text" id="option_{{$opt.ID}}" name="option_{{$opt.ID}}" value="{{$opt.Value}}">
    {{end}}

    {{if and $opt.Default (ne $opt.Type "shortcode_rules")}}<p class="option-default-hint">{{$.t.T "默认值：%s" $opt.Default}}</p>{{end}}
  </section>
  {{end}}

  <p><button type="submit" class="btn">{{.t.T "保存"}}</button></p>
</form>
{{- end}}
{{- end}}

<script src="/assets/admin.js?v={{.AssetVersion}}"></script>
{{template "admin_footer" .}}
{{- end}}
