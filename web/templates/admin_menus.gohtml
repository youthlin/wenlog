{{define "admin_menus.gohtml"}}
{{template "admin_header" .}}
<div class="page-head">
  <h1>{{.t.T "菜单"}}</h1>
</div>

{{if .Notice}}<p class="notice-banner">{{.Notice}}</p>{{end}}

<section class="card settings-card">
  <h3>{{.t.T "导航菜单"}}</h3>
  <p class="tip">{{.t.T "菜单位置由当前主题声明；菜单项可以来自页面，也可以是自定义链接。父级选择非空时会渲染为次级菜单。"}}</p>

  <form method="post" action="/admin/menus" class="settings-form menu-settings-form">
    {{template "csrf_field" .}}
    {{range .MenuLocations}}
    {{$loc := .Key}}
    <section class="card widget-area-card menu-location-card">
      <div class="widget-area-head">
        <div>
          <h4>{{if .Location.Name}}{{$.t.T .Location.Name}}{{else}}{{$loc}}{{end}}</h4>
          {{if .Location.Description}}<p class="tip">{{$.t.T .Location.Description}}</p>{{end}}
        </div>
      </div>
      <div class="table-scroll">
        <table class="data-table menu-items-table" data-menu-location="{{$loc}}">
          <thead>
          <tr>
            <th>{{$.t.T "类型"}}</th>
            <th>{{$.t.T "页面/标题"}}</th>
            <th>{{$.t.T "链接"}}</th>
            <th>{{$.t.T "父级"}}</th>
            <th>{{$.t.T "新窗口"}}</th>
            <th>{{$.t.T "操作"}}</th>
          </tr>
          </thead>
          <tbody>
          {{range .Items}}
          {{$item := .}}
          <tr>
            <td data-label="{{$.t.T "类型"}}">
              <input type="hidden" name="menu_id_{{$loc}}" value="{{.ID}}">
              <select name="menu_type_{{$loc}}" data-menu-type>
                <option value="page" {{if eq .Type "page"}}selected{{end}}>{{$.t.T "页面"}}</option>
                <option value="custom" {{if eq .Type "custom"}}selected{{end}}>{{$.t.T "自定义链接"}}</option>
              </select>
            </td>
            <td data-label="{{$.t.T "页面/标题"}}">
              <select name="menu_post_id_{{$loc}}" data-menu-page>
                <option value="0">{{$.t.T "选择页面"}}</option>
                {{range $.Pages}}<option value="{{.ID}}" {{if eq .ID $item.PostID}}selected{{end}}>{{.Title}}</option>{{end}}
              </select>
              <input type="text" name="menu_title_{{$loc}}" value="{{.Title}}" placeholder="{{$.t.T "自定义标题，可留空使用页面标题"}}">
            </td>
            <td data-label="{{$.t.T "链接"}}"><input type="text" name="menu_url_{{$loc}}" value="{{.URL}}" placeholder="/about 或 https://example.com"></td>
            <td data-label="{{$.t.T "父级"}}">
              <select name="menu_parent_{{$loc}}">
                <option value="">{{$.t.T "无"}}</option>
                {{range $.Items}}{{if ne .ID $item.ID}}<option value="{{.ID}}" {{if eq .ID $item.ParentID}}selected{{end}}>{{if .Title}}{{.Title}}{{else}}{{.ID}}{{end}}</option>{{end}}{{end}}
              </select>
            </td>
            <td data-label="{{$.t.T "新窗口"}}"><select name="menu_target_{{$loc}}"><option value="">{{$.t.T "否"}}</option><option value="_blank" {{if eq .Target "_blank"}}selected{{end}}>{{$.t.T "是"}}</option></select></td>
            <td class="actions" data-label="{{$.t.T "操作"}}"><button type="button" class="btn-secondary btn-sm" data-menu-remove>{{$.t.T "移除"}}</button></td>
          </tr>
          {{end}}
          </tbody>
        </table>
      </div>
      <p class="actions">
        <button type="button" class="btn-secondary btn-sm" data-menu-add-page="{{$loc}}">{{$.t.T "添加页面"}}</button>
        <button type="button" class="btn-secondary btn-sm" data-menu-add-custom="{{$loc}}">{{$.t.T "添加自定义链接"}}</button>
      </p>
    </section>
    {{end}}
    <button type="submit">{{.t.T "保存菜单"}}</button>
  </form>
</section>

<script>
(function(){
  function newId(){ return 'm_' + Math.random().toString(16).slice(2) + Date.now().toString(16); }
  function pageOptions(){
    return '<option value="0">{{.t.T "选择页面"}}</option>{{range .Pages}}<option value="{{.ID}}">{{js .Title}}</option>{{end}}';
  }
  function parentOptions(tbody){
    var html = '<option value="">{{.t.T "无"}}</option>';
    tbody.querySelectorAll('tr').forEach(function(row){
      var id = row.querySelector('input[name^="menu_id_"]').value;
      var titleInput = row.querySelector('input[name^="menu_title_"]');
      var title = titleInput && titleInput.value ? titleInput.value : id;
      if(id) html += '<option value="'+id.replace(/"/g,'&quot;')+'">'+title.replace(/</g,'&lt;')+'</option>';
    });
    return html;
  }
  function addRow(loc, type){
    var table = document.querySelector('[data-menu-location="'+loc+'"]');
    if(!table) return;
    var tbody = table.querySelector('tbody');
    var tr = document.createElement('tr');
    tr.innerHTML = '<td data-label="{{.t.T "类型"}}"><input type="hidden" name="menu_id_'+loc+'" value="'+newId()+'"><select name="menu_type_'+loc+'" data-menu-type><option value="page">{{.t.T "页面"}}</option><option value="custom">{{.t.T "自定义链接"}}</option></select></td>'+
      '<td data-label="{{.t.T "页面/标题"}}"><select name="menu_post_id_'+loc+'" data-menu-page>'+pageOptions()+'</select><input type="text" name="menu_title_'+loc+'" placeholder="{{.t.T "自定义标题，可留空使用页面标题"}}"></td>'+
      '<td data-label="{{.t.T "链接"}}"><input type="text" name="menu_url_'+loc+'" placeholder="/about 或 https://example.com"></td>'+
      '<td data-label="{{.t.T "父级"}}"><select name="menu_parent_'+loc+'">'+parentOptions(tbody)+'</select></td>'+
      '<td data-label="{{.t.T "新窗口"}}"><select name="menu_target_'+loc+'"><option value="">{{.t.T "否"}}</option><option value="_blank">{{.t.T "是"}}</option></select></td>'+
      '<td class="actions" data-label="{{.t.T "操作"}}"><button type="button" class="btn-secondary btn-sm" data-menu-remove>{{.t.T "移除"}}</button></td>';
    tbody.appendChild(tr);
    tr.querySelector('[data-menu-type]').value = type;
  }
  document.addEventListener('click', function(e){
    var page = e.target.closest('[data-menu-add-page]');
    if(page){ addRow(page.getAttribute('data-menu-add-page'), 'page'); return; }
    var custom = e.target.closest('[data-menu-add-custom]');
    if(custom){ addRow(custom.getAttribute('data-menu-add-custom'), 'custom'); return; }
    var remove = e.target.closest('[data-menu-remove]');
    if(remove){ remove.closest('tr').remove(); }
  });
})();
</script>
{{template "admin_footer" .}}
{{end}}
