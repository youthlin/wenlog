{{define "admin_posts.gohtml"}}
{{template "admin_header" .}}
<div class="page-head">
  <h1>{{.Title}}</h1>
  <a class="btn" href="/admin/post/new?type={{.PostType}}">{{.t.T "新建"}}</a>
</div>
<div class="table-scroll">
  <table class="data-table posts-table">
    <thead><tr><th>ID</th><th>{{.t.T "标题"}}</th><th>{{.t.T "状态"}}</th><th>{{.t.T "发布时间"}}</th><th>{{.t.T "浏览"}}</th><th>{{.t.T "操作"}}</th></tr></thead>
    <tbody>
    {{range .Posts}}
    <tr>
      {{$viewURL := postURL .}}
      {{if eq $.PostType "page"}}{{$viewURL = pageURL .}}{{end}}
      <td class="post-id-cell" data-label="ID"><span class="post-id-badge">#{{.ID}}</span></td>
      <td class="post-title-cell" data-label="{{$.t.T "标题"}}">
        <div class="post-title-panel">
          <div class="post-title-line">
            {{if $viewURL}}
            <a href="{{$viewURL}}" target="_blank" rel="noreferrer">{{if .Title}}{{.Title}}{{else}}{{$.t.T "（无标题）"}}{{end}}</a>
            {{else}}
            {{if .Title}}{{.Title}}{{else}}{{$.t.T "（无标题）"}}{{end}}
            {{end}}
          </div>
          <div class="post-meta-list">
            {{if .Slug}}<div class="post-meta-item"><small>Slug：{{.Slug}}</small></div>{{end}}
            {{if $viewURL}}<div class="post-meta-item"><small>{{$.t.T "路径"}}：<a href="{{$viewURL}}" target="_blank" rel="noreferrer">{{$viewURL}}</a></small></div>{{end}}
          </div>
        </div>
      </td>
      <td class="post-status-cell" data-label="{{$.t.T "状态"}}"><span class="post-status-badge {{if eq .Status "published"}}is-published{{else}}is-draft{{end}}">{{if eq .Status "published"}}{{$.t.T "已发布"}}{{else}}{{$.t.T "草稿"}}{{end}}</span></td>
      <td class="post-published-cell" data-label="{{$.t.T "发布时间"}}"><time class="post-published-time" datetime="{{fmtDateTime .PublishedAt}}">{{fmtDate .PublishedAt}}</time></td>
      <td class="post-views-cell" data-label="{{$.t.T "浏览"}}"><span class="post-views-value">{{.Views}}</span></td>
      <td class="actions post-actions-cell" data-label="{{$.t.T "操作"}}">
        <a class="post-action-link" href="/admin/post/{{.ID}}">{{$.t.T "编辑"}}</a>
        <form class="inline" method="post" action="/admin/post/{{.ID}}/delete" onsubmit="return confirm('{{$.t.T "确认删除?"}}')">
          {{template "csrf_field" $}}
          <button type="submit" class="link-danger">{{$.t.T "删除"}}</button>
        </form>
      </td>
    </tr>
    {{else}}
    <tr><td colspan="6">{{.t.T "暂无内容"}}</td></tr>
    {{end}}
    </tbody>
  </table>
</div>
<p class="total">{{if eq .PostType "page"}}{{.t.N64 "共 %d 个页面" "共 %d 个页面" .Total .Total}}{{else}}{{.t.N64 "共 %d 篇文章" "共 %d 篇文章" .Total .Total}}{{end}}</p>
{{if gt .Pages 1}}
<nav class="pagination">
  {{if gt .Page 1}}<a href="/admin/posts?type={{.PostType}}&page={{sub .Page 1}}">{{.t.T "上一页"}}</a>{{end}}
  <span class="page-info">{{.Page}} / {{.Pages}}</span>
  {{if lt .Page .Pages}}<a href="/admin/posts?type={{.PostType}}&page={{add .Page 1}}">{{.t.T "下一页"}}</a>{{end}}
</nav>
{{end}}
{{template "admin_footer" .}}
{{end}}
