package theme

import (
	"html"
	"net/url"
	"strings"
	"themeapi"
)

var smileyNames = []string{
	"微笑",
	"呲牙",
	"偷笑",
	"调皮",
	"可爱",
	"亲亲",
	"鼓掌",
	"坏笑",
	"得意",
	"大兵",
	"白眼",
	"疑问",
	"惊讶",
	"吓到",
	"流汗",
	"流泪",
	"难过",
	"发怒",
	"发呆",
	"撇嘴",
	"抠鼻",
}

// Register 注册主题自定义数据。
func Register() {
		themeapi.Api.RegisterData("smilies", func(args map[string]any) any {
			items := make([]map[string]string, 0, len(smileyNames))
			for _, name := range smileyNames {
				items = append(items, map[string]string{
					"name": name,
					"code": "[/" + name + "]",
					"src":  smileySrc(name),
				})
			}
			return items
	})

	themeapi.Api.RegisterData("render_comment", func(args map[string]any) any {
		content, _ := args["content"].(string)
		return renderComment(content)
	})
}

func renderComment(content string) string {
	if content == "" {
		return ""
	}
	escaped := html.EscapeString(content)
	for _, name := range smileyNames {
		code := "[/" + name + "]"
		img := `<img class="comment-smiley" src="` + smileySrc(name) + `" alt="` + name + `" title="` + name + `" width="24" height="24">`
		escaped = strings.ReplaceAll(escaped, code, img)
	}
	return escaped
}

func smileySrc(name string) string {
	return "/theme-assets/smilies/" + url.PathEscape(name) + ".gif"
}
