{{- define "index.gohtml" -}}
{{template "header" .}}
<div class="post-list">
  {{range .List.Posts}}
  <article class="{{post_class . "post-summary"}}">
    <h2 class="post-title"><a href="{{post_url .}}">{{post_title_text .}}</a></h2>
    <div class="post-meta">
      <time>{{fmt_date .PublishedAt}}</time>
      {{if .Author.DisplayName}}<span class="author">{{.Author.DisplayName}}</span>{{end}}
      {{range .Categories}}<a class="cat" href="{{category_url .Slug}}">{{.Name}}</a>{{end}}
      {{range .Tags}}<a class="tag" href="{{tag_url .Slug}}">#{{.Name}}</a>{{end}}
      <span class="views">{{$.th.N1_64 "%d 次阅读" .Views .Views}}</span>
      {{if eq .CommentStatus "closed"}}<span class="comment-count">{{$.th.T "评论已关闭"}}</span>
      {{else if eq .CommentCount 0}}<a class="comment-count" href="{{post_url .}}#comments">{{$.th.T "暂无评论"}}</a>
      {{else}}<a class="comment-count" href="{{post_url .}}#comments">{{$.th.N1_64 "%d 条评论" .CommentCount .CommentCount}}</a>{{end}}
      {{if and $.CurrentUserID (eq $.CurrentUserID .AuthorID)}}<a class="edit-link" href="/admin/post/{{.ID}}">{{$.th.T "编辑"}}</a>{{end}}
    </div>
    <div class="post-content">{{post_excerpt .}}</div>
    {{if has_more .Content}}<a class="read-more" href="{{post_url .}}#more-{{.ID}}">{{$.th.T "阅读全文 →"}}</a>{{end}}
  </article>
  {{end}}
</div>
{{posts_pagination . 2}}
{{template "footer" .}}
{{- end}}
