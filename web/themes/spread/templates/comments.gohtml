{{define "comments"}}
<section class="comments wide-shell" id="comments">
  <div class="comments-inner">
    <p class="section-kicker">{{.th.T "读者回声"}}</p>
    <h2>{{if eq .CommentCount 0}}{{.th.T "暂无评论"}}{{else}}{{.th.N1_64 "%d 条评论" .CommentCount .CommentCount}}{{end}}</h2>
    <div id="comments-box">
      {{template "fragment_comments.gohtml" .}}
    </div>
  </div>
</section>
<script src="/assets/comment.js"></script>
{{end}}

{{define "fragment_comments.gohtml"}}
  <ul class="comment-list">
    {{range .Comments}}
    {{if eq .ParentID 0}}
    <li class="comment{{if eq .Status "pending"}} comment-pending{{end}}" id="comment-{{.ID}}">
      <div class="comment-head">
        <img class="avatar" src="{{avatarURL .Email $.DefaultAvatar}}" alt="" width="44" height="44">
        <a class="comment-id" href="#comment-{{.ID}}">#{{.ID}}</a>
        <span class="comment-author">{{.Author}}</span>
        {{if .CommenterRole}}<span class="comment-badge comment-badge-{{.CommenterRole}}" title="{{if eq .CommenterRole "author"}}{{$.th.T "文章作者"}}{{else if eq .CommenterRole "admin"}}{{$.th.T "管理员"}}{{else}}{{$.th.T "登录用户"}}{{end}}"></span>{{end}}
        {{if .NotifyOnReply}}<span class="comment-badge comment-badge-notify" title="{{$.th.T "回复时邮件通知"}}"></span>{{end}}
        <time>{{fmtDateTime .CreatedAt}}</time>
        {{if eq .Status "pending"}}<span class="comment-pending-badge">{{$.th.T "评论审核中,当前仅自己可见"}}</span>{{end}}
      </div>
      <div class="comment-body">{{.Content}}</div>
      <button class="comment-reply" type="button" data-reply="{{.ID}}" data-reply-target="comment-{{.ID}}">{{$.th.T "回复"}}</button>
      {{$pid := .ID}}
      <ul class="comment-children">
        {{range $.Comments}}
        {{if eq .ParentID $pid}}
        <li class="comment{{if eq .Status "pending"}} comment-pending{{end}}" id="comment-{{.ID}}">
          <div class="comment-head">
            <img class="avatar" src="{{avatarURL .Email $.DefaultAvatar}}" alt="" width="40" height="40">
            <a class="comment-id" href="#comment-{{.ID}}">#{{.ID}}</a>
            <span class="comment-author">{{.Author}}</span>
            {{if .CommenterRole}}<span class="comment-badge comment-badge-{{.CommenterRole}}" title="{{if eq .CommenterRole "author"}}{{$.th.T "文章作者"}}{{else if eq .CommenterRole "admin"}}{{$.th.T "管理员"}}{{else}}{{$.th.T "登录用户"}}{{end}}"></span>{{end}}
            {{if .NotifyOnReply}}<span class="comment-badge comment-badge-notify" title="{{$.th.T "回复时邮件通知"}}"></span>{{end}}
            <time>{{fmtDateTime .CreatedAt}}</time>
            {{if eq .Status "pending"}}<span class="comment-pending-badge">{{$.th.T "评论审核中,当前仅自己可见"}}</span>{{end}}
          </div>
          <div class="comment-body">{{if .ReplyToAuthor}}<a class="comment-reply-to" href="#comment-{{.ReplyToID}}">{{$.th.T "回复 @%s" .ReplyToAuthor}}</a>{{end}}{{.Content}}</div>
          <button class="comment-reply" type="button" data-reply="{{.ID}}" data-reply-target="comment-{{.ID}}">{{$.th.T "回复"}}</button>
        </li>
        {{end}}
        {{end}}
      </ul>
    </li>
    {{end}}
    {{end}}
  </ul>

  {{if gt .CommentPager.Pages 1}}
  <nav class="pagination comment-pagination">
    {{if gt .CommentPager.Page 1}}<a href="{{.CommentPager.BaseURL}}?cpage={{sub .CommentPager.Page 1}}#comments" data-cpage="{{sub .CommentPager.Page 1}}">{{.th.T "上一页"}}</a>{{end}}
    <span class="page-info">{{.CommentPager.Page}} / {{.CommentPager.Pages}}</span>
    {{if lt .CommentPager.Page .CommentPager.Pages}}<a href="{{.CommentPager.BaseURL}}?cpage={{add .CommentPager.Page 1}}#comments" data-cpage="{{add .CommentPager.Page 1}}">{{.th.T "下一页"}}</a>{{end}}
  </nav>
  {{end}}

  {{if .CurrentUser}}
  <div class="comment-login-tip">{{if .CurrentUser.DisplayName}}{{safeHTML (.th.T "以 <strong>%s</strong> 的身份发表评论，" (escapeHTML .CurrentUser.DisplayName))}}{{else}}{{safeHTML (.th.T "以 <strong>%s</strong> 的身份发表评论，" (escapeHTML .CurrentUser.Username))}}{{end}}
    <form class="inline" method="post" action="/auth/logout">{{template "csrf_field" .}}<button type="submit">{{.th.T "登出"}}</button></form>
  </div>
  {{end}}

  {{if .CommentOpen}}
  <div id="comment-form-home"></div>
  <form class="comment-form" id="comment-form" method="post" action="/comment">
    <input type="hidden" name="post_id" value="{{.Post.ID}}">
    <input type="hidden" name="parent_id" value="0">
    <input type="hidden" name="reply_to_id" value="0">
    {{if .CSRFToken}}<input type="hidden" name="_csrf" value="{{.CSRFToken}}">{{end}}
    {{if not .CurrentUser}}
      <p><label class="sr-only" for="comment-author">{{.th.T "昵称"}}</label><input id="comment-author" type="text" name="author" value="{{.RememberedCommenter.Author}}" placeholder="{{.th.T "昵称 *"}}" autocomplete="name" required></p>
      <p><label class="sr-only" for="comment-email">{{.th.T "邮箱"}}</label><input id="comment-email" type="email" name="email" value="{{.RememberedCommenter.Email}}" placeholder="{{.th.T "邮箱 *(不公开)"}}" autocomplete="email" required></p>
      <p><label class="sr-only" for="comment-url">{{.th.T "网站"}}</label><input id="comment-url" type="url" name="url" value="{{.RememberedCommenter.URL}}" placeholder="{{.th.T "网站(可选)"}}" autocomplete="url"></p>
    {{end}}
    <p class="hp"><input type="text" name="website" tabindex="-1" autocomplete="off"></p>
    <p><label class="sr-only" for="comment-content">{{.th.T "评论内容"}}</label><textarea id="comment-content" name="content" rows="6" placeholder="{{.th.T "说点什么吧…… *"}}" required></textarea></p>
    {{if .MailEnabled}}<p><label><input type="checkbox" name="notify"> {{.th.T "有回复时邮件通知我"}}</label></p>{{end}}
    <p class="comment-form-actions"><button type="submit">{{.th.T "提交评论"}}</button><button type="button" class="comment-cancel-reply" data-cancel-reply hidden>{{.th.T "取消回复"}}</button></p>
    <p class="comment-tip">{{.th.T "评论提交后需经审核才会显示。"}}</p>
  </form>
  {{else}}
  <p class="comment-closed">{{.th.T "评论已关闭"}}</p>
  {{end}}
{{end}}
