package theme

import (
	"sort"
	"strconv"
	"themeapi"
)

// Register 注册主题的自定义数据提供者。
// 常用数据（RecentPosts、Categories、Tags 等）已全局可用，无需在此注册。
func Register() {
	// popular_posts: 热门文章（按浏览量排序）
	themeapi.Api.RegisterData("popular_posts", func(args map[string]any) any {
		n := getInt(args, "n", 5)
		posts := themeapi.Api.Posts()
		sort.Slice(posts, func(i, j int) bool {
			return posts[i].Views > posts[j].Views
		})
		if n > len(posts) {
			n = len(posts)
		}
		return posts[:n]
	})

	// saying: 博主动态（读取 saying_post_id 主题选项，返回博主评论）
	themeapi.Api.RegisterData("saying", func(args map[string]any) any {
		postIDStr := themeapi.Api.Setting("option_default_saying_post_id")
		if postIDStr == "" {
			return nil
		}
		postID, err := strconv.Atoi(postIDStr)
		if err != nil || postID <= 0 {
			return nil
		}
		n := getInt(args, "n", 5)
		return themeapi.Api.SayingItems(uint(postID), n)
	})
}

func getInt(args map[string]any, key string, def int) int {
	if v, ok := args[key]; ok {
		switch n := v.(type) {
		case int:
			return n
		case int64:
			return int(n)
		case float64:
			return int(n)
		}
	}
	return def
}
