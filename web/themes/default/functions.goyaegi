package theme

import (
	"sort"
	"themeapi"
)

// Register 注册默认主题的内置数据提供者。
// 这些 provider 替代了 v1 的 builtin_widgets.go。
// themeapi.Api 由宿主通过 i.Use 注入为全局变量。
func Register() {
	// recent_posts: 近期文章
	themeapi.Api.RegisterData("recent_posts", func(args map[string]any) any {
		n := getInt(args, "n", 8)
		return themeapi.Api.RecentPosts(n)
	})

	// recent_comments: 近期评论
	themeapi.Api.RegisterData("recent_comments", func(args map[string]any) any {
		n := getInt(args, "n", 8)
		return themeapi.Api.RecentComments(n)
	})

	// categories: 分类列表
	themeapi.Api.RegisterData("categories", func(args map[string]any) any {
		return themeapi.Api.Categories()
	})

	// tags: 标签列表
	themeapi.Api.RegisterData("tags", func(args map[string]any) any {
		return themeapi.Api.Tags()
	})

	// archive_months: 归档月份
	themeapi.Api.RegisterData("archive_months", func(args map[string]any) any {
		return themeapi.Api.ArchiveMonths()
	})

	// saying: 博主动态（指定文章下博主本人的评论）
	themeapi.Api.RegisterData("saying", func(args map[string]any) any {
		postID := getUint(args, "post_id", 0)
		n := getInt(args, "n", 5)
		if postID == 0 {
			return nil
		}
		post := themeapi.Api.Post(postID)
		if post == nil {
			return nil
		}
		allComments := themeapi.Api.CommentsByPost(postID)
		var authorComments []CommentView
		for _, c := range allComments {
			if c.Author == post.Author.DisplayName || c.Author == post.Author.Username {
				authorComments = append(authorComments, c)
			}
		}
		sort.Slice(authorComments, func(i, j int) bool {
			return authorComments[i].CreatedAt.After(authorComments[j].CreatedAt)
		})
		if n > len(authorComments) {
			n = len(authorComments)
		}
		return map[string]any{
			"Items":        authorComments[:n],
			"AuthorName":   post.Author.DisplayName,
			"AuthorEmail":  post.Author.Email,
		}
	})

	// popular_posts: 热门文章（按浏览量排序）
	themeapi.Api.RegisterData("popular_posts", func(args map[string]any) any {
		n := getInt(args, "n", 5)
		posts := themeapi.Api.Posts()
		sort.Slice(posts, func(i, j int) bool {
			return posts[i].Views > posts[j].Views
		})
		if n > len(posts) {
			n = len(posts)
		}
		return posts[:n]
	})
}

func getInt(args map[string]any, key string, def int) int {
	if v, ok := args[key]; ok {
		switch n := v.(type) {
		case int:
			return n
		case int64:
			return int(n)
		case float64:
			return int(n)
		}
	}
	return def
}

func getUint(args map[string]any, key string, def uint) uint {
	if v, ok := args[key]; ok {
		switch n := v.(type) {
		case uint:
			return n
		case int:
			if n >= 0 {
				return uint(n)
			}
		case int64:
			if n >= 0 {
				return uint(n)
			}
		case float64:
			if n >= 0 {
				return uint(n)
			}
		}
	}
	return def
}
