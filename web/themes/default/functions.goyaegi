package theme

import (
	"sort"
	"hook"
)

// Register 注册主题的自定义数据提供者。
// 常用数据（RecentPosts、Categories、Tags 等）已全局可用，无需在此注册。
func Register(api *hook.API) {
	// popular_posts: 热门文章（按浏览量排序）
	api.RegisterFunc("popular_posts", func(api *hook.API, args hook.Args) any {
		n := args.PositiveInt("n", 5)
		posts := api.Posts()
		sort.Slice(posts, func(i, j int) bool {
			return posts[i].Views > posts[j].Views
		})
		if n > len(posts) {
			n = len(posts)
		}
		return posts[:n]
	})
}
