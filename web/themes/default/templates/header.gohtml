{{define "header"}}<!DOCTYPE html>
<html lang="{{.htmlLang}}" data-theme="dark"
      data-comment-success="{{.t.T "评论已提交,等待审核后显示。"}}"
      data-comment-fail="{{.t.T "提交失败,请稍后重试。"}}"
      data-comment-network="{{.t.T "网络错误,请稍后重试。"}}"
      data-nav-open-label="{{.t.T "打开菜单"}}"
      data-nav-close-label="{{.t.T "收起菜单"}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
{{if .Description}}<meta name="description" content="{{.Description}}">{{end}}
<link rel="stylesheet" href="/assets/style.css">
<link rel="alternate" type="application/rss+xml" title="{{.SiteName}}" href="/feed">
<script>(function(){try{var themes=['dark','light','red-plum','bamboo','lotus','orange','azure','purple'];var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',themes.indexOf(t)>=0?t:'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();</script>
</head>
<body>
<a class="skip-link" href="#main-content">{{.t.T "跳到主要内容"}}</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="site-title" href="/">{{.SiteName}}</a>
    <nav id="site-nav-menu" class="site-nav" data-nav-panel>
      <div class="site-nav-links">
        {{range .Menu}}<a href="{{postURL .}}">{{.Title}}</a>{{end}}
      </div>
      <div class="site-nav-utility" aria-label="{{.t.T "界面设置"}}">
        <label class="lang-select-wrap">
          <span class="sr-only">{{.t.T "语言"}}</span>
          <select class="lang-select" aria-label="{{.t.T "语言"}}" onchange="if(this.value)location=this.value">
            <option value="{{index .langURL "zh_CN"}}" {{if eq (.usedLocale) "zh_CN"}}selected{{end}}>{{.t.T "中文"}}</option>
            <option value="{{index .langURL "en_US"}}" {{if eq (.usedLocale) "en_US"}}selected{{end}}>{{.t.T "English"}}</option>
          </select>
        </label>
        <label class="theme-select-wrap">
          <span class="sr-only">{{.t.T "切换主题"}}</span>
          <select class="theme-select" data-theme-select aria-label="{{.t.T "切换主题"}}">
            <option value="dark">{{.t.T "暗黑"}}</option>
            <option value="light">{{.t.T "明亮"}}</option>
            <option value="red-plum">{{.t.T "红梅"}}</option>
            <option value="bamboo">{{.t.T "绿竹"}}</option>
            <option value="lotus">{{.t.T "藕粉"}}</option>
            <option value="orange">{{.t.T "橙黄"}}</option>
            <option value="azure">{{.t.T "蔚蓝"}}</option>
            <option value="purple">{{.t.T "韵紫"}}</option>
          </select>
        </label>
      </div>
    </nav>
    <div class="header-actions">
      <button type="button" class="nav-toggle" data-nav-toggle aria-label="{{.t.T "打开菜单"}}" aria-controls="site-nav-menu" aria-expanded="false">☰</button>
    </div>
  </div>
</header>
<div class="container layout">
<main class="main-col" id="main-content">
{{end}}
