{{- define "archive.gohtml" -}}
{{template "header" .}}
<article class="{{post_class .Post "page-detail"}}">
  <h1 class="post-title">{{post_title_text .Post}}</h1>
  {{if .Post.Content}}<div class="post-content">{{safeHTML .Post.Content}}</div>{{end}}
  <div class="archive-groups">
    {{range .Groups}}
    <h3 class="archive-year" id="{{.Year}}">{{.Year}}</h3>
    <ul class="archive-list">
      {{range .Posts}}
      <li><time>{{fmtDate .PublishedAt}}</time> <a href="{{postURL .}}">{{post_title_text .}}</a></li>
      {{end}}
    </ul>
    {{end}}
  </div>
</article>
{{template "footer" .}}
{{- end}}
